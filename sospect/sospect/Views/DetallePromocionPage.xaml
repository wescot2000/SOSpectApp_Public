<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             xmlns:converters="clr-namespace:sospect.Converters"
             BackgroundColor="#F8F9FA"
             x:Class="sospect.Views.DetallePromocionPage"
             Title="{helpers:TranslateExtension Text='LblDetallePromocion'}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorGreenGrayConverter x:Key="BoolToColorGreenGrayConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <Style x:Key="LabelTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#34495E"/>
            </Style>

            <Style x:Key="LabelValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
                <Setter Property="TextColor" Value="#2C3E50"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#9B59B6"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <ScrollView Padding="16">
                <StackLayout Spacing="0">

                    <!-- Sección: Información del Emprendimiento -->
                    <Label Text="{helpers:TranslateExtension Text='LblNombreEmprendimiento'}"
                           Style="{StaticResource SectionTitleStyle}"/>
                    <Frame BackgroundColor="White"
                           Padding="16"
                           CornerRadius="12"
                           HasShadow="True"
                           BorderColor="Transparent"
                           Margin="0,0,0,8">
                        <StackLayout Spacing="12">
                            <!-- Nombre Emprendimiento -->
                            <StackLayout Spacing="4">
                                <Label Text="{helpers:TranslateExtension Text='LblNombreEmprendimiento'}"
                                       Style="{StaticResource LabelTitleStyle}"/>
                                <Label Text="{Binding Detalle.NombreEmprendimiento}"
                                       Style="{StaticResource LabelValueStyle}"/>
                            </StackLayout>

                            <!-- NIT/Cédula -->
                            <StackLayout Spacing="4">
                                <Label Text="{helpers:TranslateExtension Text='LblNitCedula'}"
                                       Style="{StaticResource LabelTitleStyle}"/>
                                <Label Text="{Binding Detalle.NitCedulaPropietario}"
                                       Style="{StaticResource LabelValueStyle}"/>
                            </StackLayout>

                            <!-- Descripción Promocional -->
                            <StackLayout Spacing="4">
                                <Label Text="{helpers:TranslateExtension Text='LblDescripcionPromocional'}"
                                       Style="{StaticResource LabelTitleStyle}"/>
                                <Label Text="{Binding Detalle.DescripcionPromocional}"
                                       Style="{StaticResource LabelValueStyle}"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Sección: Configuración de la Promoción -->
                    <Label Text="{helpers:TranslateExtension Text='LblConfiguracionPromocion'}"
                           Style="{StaticResource SectionTitleStyle}"/>
                    <Frame BackgroundColor="White"
                           Padding="16"
                           CornerRadius="12"
                           HasShadow="True"
                           BorderColor="Transparent"
                           Margin="0,0,0,8">
                        <StackLayout Spacing="12">
                            <!-- Grid: Poderes y Radio -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackLayout Spacing="4" Grid.Column="0">
                                    <Label Text="{helpers:TranslateExtension Text='LblPoderesUsados'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.PoderesConsumidos}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>

                                <StackLayout Spacing="4" Grid.Column="1">
                                    <Label Text="{helpers:TranslateExtension Text='LblRadioAlcance'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.RadioMetros, StringFormat='{0} m'}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>
                            </Grid>

                            <!-- Grid: Duración y Media -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackLayout Spacing="4" Grid.Column="0">
                                    <Label Text="{helpers:TranslateExtension Text='LblDuracionDias'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.DuracionDias}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>

                                <StackLayout Spacing="4" Grid.Column="1">
                                    <Label Text="{helpers:TranslateExtension Text='LblCantidadMedia'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.CantidadMediaAdjunta}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>
                            </Grid>

                            <!-- Grid: Fechas -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackLayout Spacing="4" Grid.Column="0">
                                    <Label Text="{helpers:TranslateExtension Text='LblFechaInicio'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.FechaActivacion, StringFormat='{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>

                                <StackLayout Spacing="4" Grid.Column="1">
                                    <Label Text="{helpers:TranslateExtension Text='LblFechaFin'}"
                                           Style="{StaticResource LabelTitleStyle}"/>
                                    <Label Text="{Binding Detalle.FechaFinalizacion, StringFormat='{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource LabelValueStyle}"/>
                                </StackLayout>
                            </Grid>

                            <!-- Opciones habilitadas -->
                            <Label Text="{helpers:TranslateExtension Text='LblOpcionesHabilitadas'}"
                                   Style="{StaticResource LabelTitleStyle}"
                                   Margin="0,8,0,4"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                    <Label Text="Logo:"
                                           Style="{StaticResource LabelValueStyle}"/>
                                    <Label Text="{Binding LogoTexto}"
                                           TextColor="{Binding Detalle.LogoHabilitado, Converter={StaticResource BoolToColorGreenGrayConverter}}"/>
                                </StackLayout>

                                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Label Text="Chat:"
                                           Style="{StaticResource LabelValueStyle}"/>
                                    <Label Text="{Binding ContactoTexto}"
                                           TextColor="{Binding Detalle.ContactoHabilitado, Converter={StaticResource BoolToColorGreenGrayConverter}}"/>
                                </StackLayout>

                                <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Label Text="Envío:"
                                           Style="{StaticResource LabelValueStyle}"/>
                                    <Label Text="{Binding DomicilioTexto}"
                                           TextColor="{Binding Detalle.DomicilioHabilitado, Converter={StaticResource BoolToColorGreenGrayConverter}}"/>
                                </StackLayout>
                            </Grid>

                            <!-- Texto Push -->
                            <StackLayout Spacing="4" IsVisible="{Binding TieneTextoPush}">
                                <Label Text="{helpers:TranslateExtension Text='LblTextoPush'}"
                                       Style="{StaticResource LabelTitleStyle}"/>
                                <Frame BackgroundColor="#F0F0F0"
                                       Padding="12"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <Label Text="{Binding Detalle.TextoPushPersonalizado}"
                                           Style="{StaticResource LabelValueStyle}"
                                           FontAttributes="Italic"/>
                                </Frame>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Sección: Estadísticas de Notificaciones -->
                    <Label Text="{helpers:TranslateExtension Text='LblUsuariosNotificados'}"
                           Style="{StaticResource SectionTitleStyle}"/>
                    <Frame BackgroundColor="White"
                           Padding="16"
                           CornerRadius="12"
                           HasShadow="True"
                           BorderColor="Transparent"
                           Margin="0,0,0,8">
                        <StackLayout Spacing="12">
                            <!-- Estadísticas resumen -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Frame Grid.Column="0"
                                       BackgroundColor="#27AE60"
                                       Padding="8"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <StackLayout>
                                        <Label Text="{Binding Detalle.EstadisticasNotificacion.EnviosAceptados}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{helpers:TranslateExtension Text='LblEnvioAceptado'}"
                                               TextColor="White"
                                               FontSize="10"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Frame>

                                <Frame Grid.Column="1"
                                       BackgroundColor="#E74C3C"
                                       Padding="8"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <StackLayout>
                                        <Label Text="{Binding Detalle.EstadisticasNotificacion.EnviosRechazados}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{helpers:TranslateExtension Text='LblEnvioRechazado'}"
                                               TextColor="White"
                                               FontSize="10"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Frame>

                                <Frame Grid.Column="2"
                                       BackgroundColor="#9B59B6"
                                       Padding="8"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <StackLayout>
                                        <Label Text="{Binding Detalle.EstadisticasNotificacion.TotalUsuarios}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{helpers:TranslateExtension Text='LblTotalNotificados'}"
                                               TextColor="White"
                                               FontSize="10"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Separador -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="#E0E0E0"
                                     Margin="0,8,0,8"/>

                            <!-- Lista de usuarios notificados -->
                            <Label Text="{helpers:TranslateExtension Text='LblListadoUsuarios'}"
                                   Style="{StaticResource LabelTitleStyle}"/>

                            <CollectionView ItemsSource="{Binding UsuariosNotificados}"
                                            HeightRequest="300">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame BackgroundColor="#F8F9FA"
                                               Padding="12"
                                               Margin="0,4"
                                               CornerRadius="8"
                                               HasShadow="False"
                                               BorderColor="#E0E0E0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding UserIdThirdparty}"
                                                       FontSize="13"
                                                       FontFamily="Courier New"
                                                       TextColor="#2C3E50"
                                                       VerticalOptions="Center"/>
                                                <Frame Grid.Column="1"
                                                       BackgroundColor="{Binding EnvioAceptadoFirebase, Converter={StaticResource BoolToColorGreenGrayConverter}}"
                                                       Padding="8,4"
                                                       CornerRadius="4"
                                                       HasShadow="False">
                                                    <Label Text="{Binding EstadoTexto}"
                                                           TextColor="White"
                                                           FontSize="11"/>
                                                </Frame>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="{helpers:TranslateExtension Text='LblNoHayRegistros'}"
                                           TextColor="#7F8C8D"
                                           HorizontalOptions="Center"
                                           Margin="0,20"/>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </StackLayout>
                    </Frame>

                    <!-- Espacio final -->
                    <BoxView HeightRequest="20"/>

                </StackLayout>
            </ScrollView>

            <!-- Loading -->
            <Grid BackgroundColor="Black"
                  Opacity="0.5"
                  IsVisible="{Binding IsRunning}">
                <ActivityIndicator VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   HeightRequest="50"
                                   WidthRequest="50"
                                   Color="#9B59B6"
                                   IsRunning="{Binding IsRunning}"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
