<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    x:Class="sospect.Views.LoginPage">
    <ContentPage.Content>
        <Grid>
            <!-- Background Image -->
            <Image Aspect="AspectFill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <Image.Source>
                    <OnPlatform x:TypeArguments="ImageSource">
                        <On Platform="iOS" Value="splash_sospect.png"/>
                        <On Platform="Android" Value="splash_sospect.png"/>
                    </OnPlatform>
                </Image.Source>
            </Image>

            <!-- Main Content -->
            <Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.07345132743*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.07345132743*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2032893652*"/>
                        <RowDefinition Height="0.6619373454*"/>
                        <RowDefinition Height="0.1347732894*"/>
                    </Grid.RowDefinitions>

                    <!-- Login Frame -->
                    <Frame BackgroundColor="Transparent" HasShadow="False" Grid.Column="1" Grid.Row="1">
                        <Grid BackgroundColor="White" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.05*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.05*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!-- Estructura EXACTA de producción -->
                                <RowDefinition Height="*"/>
                                <!-- Spacer superior -->
                                <RowDefinition Height="*"/>
                                <!-- Welcome title -->
                                <RowDefinition Height="Auto"/>
                                <!-- Log in to continue -->
                                <RowDefinition Height="Auto"/>
                                <!-- Spacer -->
                                <RowDefinition Height="Auto"/>
                                <!-- (reservado) -->
                                <RowDefinition Height="5"/>
                                <!-- Spacer pequeño -->
                                <RowDefinition Height="Auto"/>
                                <!-- Google button -->
                                <RowDefinition Height="Auto"/>
                                <!-- Apple button -->
                            </Grid.RowDefinitions>

                            <!-- Welcome Label - TEXTO TRADUCIBLE + RESPONSIVO + MÁS ESPACIO -->
                            <Label Text="{helpers:TranslateExtension Text='Bienvenido'}"
                                   FontSize="{Binding FontSizeLarge}"
                                   TextColor="Black"
                                   x:Name="Bienvenido"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
                                   Padding="5,0"/>

                            <!-- Login Instructions - RESPONSIVO -->
                            <Label Text="{helpers:TranslateExtension Text='InicieSesion'}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="{Binding FontSizeMicro}"
                                   TextColor="Gray"
                                   x:Name="InciarSesionLabel"
                                   Grid.Column="1"
                                   Grid.Row="2"/>

                            <!-- Social Login Separator - OCULTO como en producción -->
                            <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="0" Padding="0" IsVisible="false">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- Separador "or log in with" - OCULTO como en producción -->
                            <Grid IsVisible="false" Grid.Row="8" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height=".5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <BoxView HeightRequest="1" BackgroundColor="LightGray" Grid.Row="1"/>
                                </Grid>

                                <Label Text="{helpers:TranslateExtension Text='InicieSesionCon'}"
                                       Grid.Column="2"
                                       FontSize="{Binding FontSizeMicro}"
                                       x:Name="InicieSesionConLabel"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                                <Grid IsVisible="false" Grid.Column="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height=".5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <BoxView HeightRequest="1" BackgroundColor="LightGray" Grid.Row="1"/>
                                </Grid>
                            </Grid>

                            <!-- Google Button - ALTURA MAYOR + DISEÑO ELEGANTE -->
                            <Button Text="{helpers:TranslateExtension Text='SesionGoogle'}"
                                    HorizontalOptions="FillAndExpand"
                                    Grid.Column="1"
                                    Grid.Row="6"
                                    FontSize="{Binding FontSizeSmall}"
                                    x:Name="GoogleBoton"
                                    Command="{Binding GoogleCommand}"
                                    TextColor="White"
                                    BackgroundColor="#D50000"
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Margin="0,8,0,8"
                                    FontAttributes="Bold">
                                <Button.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3"/>
                                </Button.Shadow>
                            </Button>

                            <!-- Apple Button - ALTURA MAYOR + DISEÑO ELEGANTE -->
                            <Button Text="{helpers:TranslateExtension Text='SesionApple'}"
                                    HorizontalOptions="FillAndExpand"
                                    Grid.Column="1"
                                    Grid.Row="7"
                                    FontSize="{Binding FontSizeSmall}"
                                    x:Name="AppleBoton"
                                    Command="{Binding AppleCommand}"
                                    TextColor="White"
                                    BackgroundColor="Black"
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Margin="0,8,0,8"
                                    FontAttributes="Bold">
                                <Button.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.3"/>
                                </Button.Shadow>
                            </Button>

                            <!-- Facebook Button - OCULTO + RESPONSIVO -->
                            <Button Margin="0,5"
                                    Text="{helpers:TranslateExtension Text='SesionFacebook'}"
                                    HorizontalOptions="FillAndExpand"
                                    Grid.Column="1"
                                    Grid.Row="7"
                                    FontSize="{Binding FontSizeMicro}"
                                    Padding="10"
                                    TextColor="White"
                                    x:Name="FacebookBoton"
                                    Command="{Binding FacebookCommand}"
                                    CornerRadius="13"
                                    IsVisible="False"
                                    BackgroundColor="#3B5998"
                                    MinimumHeightRequest="{Binding ButtonMinHeight}"/>
                        </Grid>
                    </Frame>
                </Grid>

                <!-- Loading Overlay - RESPONSIVO -->
                <Grid BackgroundColor="Black" 
                      Opacity="0.5" 
                      HorizontalOptions="FillAndExpand" 
                      VerticalOptions="FillAndExpand" 
                      IsVisible="{Binding IsRunning}">
                    <ActivityIndicator VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       HeightRequest="50" 
                                       WidthRequest="50" 
                                       Color="DarkBlue" 
                                       IsRunning="{Binding IsRunning}"/>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
    