<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="sospect.Views.TermsAndConditionsPage"
            xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
            xmlns:helpers="clr-namespace:sospect.Helpers"
            xmlns:Converters="clr-namespace:sospect.Converters"
            BackgroundColor="#F8F9FA"
            Title="{helpers:TranslateExtension Text='LblTerminos'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Contenido principal -->
        <ScrollView Padding="20,10,20,20"
                    IsVisible="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
            <StackLayout Spacing="0">

                <!-- Header con título e icono -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="25,20"
                       Margin="0,10,0,20">
                    <StackLayout Spacing="15">
                        <!-- Icono del documento -->
                        <Frame BackgroundColor="#E3F2FD"
                               CornerRadius="30"
                               WidthRequest="60"
                               HeightRequest="60"
                               Padding="0"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <Label Text="📋"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Título principal -->
                        <Label Text="{helpers:TranslateExtension Text='LblTerminos'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               HorizontalTextAlignment="Center"/>

                        <!-- Subtítulo -->
                        <Label Text="{helpers:TranslateExtension Text='LblLeeTerminosDetenidamente'}"
                               FontSize="14"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Frame>

                <!-- Contenido de términos y condiciones -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="0"
                       Margin="0,0,0,20">

                    <!-- ScrollView interno para el texto -->
                    <ScrollView MaximumHeightRequest="400"
                                Padding="20">
                        <Label Text="{Binding TermsAndConditionsText}"
                               FontSize="14"
                               TextColor="#333333"
                               LineBreakMode="WordWrap"/>
                    </ScrollView>
                </Frame>

                <!-- Botones de acción (solo visibles cuando se debe firmar) -->
                <StackLayout IsVisible="{Binding FlagUsuarioDebeFirmar}"
                            Spacing="15">

                    <!-- Botón Acepto -->
                    <Border StrokeThickness="0"
                            BackgroundColor="#4CAF50"
                            Padding="0"
                            HeightRequest="55">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AcceptTermsCommand}"/>
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#4CAF50"
                                    Opacity="0.3"
                                    Radius="8"
                                    Offset="0,4"/>
                        </Border.Shadow>

                        <Grid>
                            <StackLayout Orientation="Horizontal"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Spacing="10">
                                <!-- Icono de check -->
                                <Label Text="✓"
                                       FontSize="18"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>

                                <!-- Texto del botón -->
                                <Label Text="{helpers:TranslateExtension Text='LblAcepto'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- Botón No Acepto -->
                    <Border StrokeThickness="2"
                            Stroke="#E0E0E0"
                            BackgroundColor="White"
                            Padding="0"
                            HeightRequest="55">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeclineTermsCommand}"/>
                        </Border.GestureRecognizers>

                        <Grid>
                            <StackLayout Orientation="Horizontal"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Spacing="10">
                                <!-- Icono de X -->
                                <Label Text="✗"
                                       FontSize="16"
                                       TextColor="#F44336"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>

                                <!-- Texto del botón -->
                                <Label Text="{helpers:TranslateExtension Text='LblNoAcepto'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#666666"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </Border>
                </StackLayout>

                <!-- Nota informativa cuando es solo lectura -->
                <Frame IsVisible="{Binding FlagUsuarioDebeFirmar, Converter={StaticResource InverseBooleanConverter}}"
                       BackgroundColor="#E8F5E8"
                       CornerRadius="10"
                       HasShadow="False"
                       Padding="15"
                       Margin="0,10,0,0">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="ℹ️"
                               FontSize="16"
                               VerticalOptions="Center"/>
                        <Label Text="{helpers:TranslateExtension Text='LblVisualizacionSoloLectura'}"
                               FontSize="14"
                               TextColor="#2E7D32"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Frame>

                <!-- Espaciado final -->
                <BoxView HeightRequest="20" 
                         Color="Transparent"/>

            </StackLayout>
        </ScrollView>

        <!-- Overlay de carga -->
        <Grid BackgroundColor="#000000"
              Opacity="0.6"
              IsVisible="{Binding IsRunning}">

            <!-- Frame con indicador de carga moderno -->
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   WidthRequest="150"
                   HeightRequest="120"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HasShadow="True"
                   Padding="20">
                <StackLayout Spacing="15"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                    <ActivityIndicator Color="#1465bb"
                                     IsRunning="{Binding IsRunning}"
                                     HeightRequest="40"
                                     WidthRequest="40"/>

                    <Label Text="{helpers:TranslateExtension Text='LblProcesando'}"
                           FontSize="14"
                           TextColor="#666666"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>