<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.Views.ConfirmationPage"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             BackgroundColor="#80000000">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ConfirmationCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="32" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="MaximumWidthRequest" Value="400" />
            </Style>

            <Style x:Key="TitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#2C3E50" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="MessageStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#7F8C8D" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="LineHeight" Value="1.4" />
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>

            <Style x:Key="ButtonFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="MinimumWidthRequest" Value="120" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
            </Style>

            <Style x:Key="ButtonLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Frame Style="{StaticResource ConfirmationCardStyle}">
            <StackLayout Spacing="0">
                <!-- Icono de pregunta -->
                <Label Text="{x:Static fonts:IconFont.CircleQuestion}"
                       FontFamily="{StaticResource IcoMoonFamily}"
                       FontSize="56"
                       TextColor="#F39C12"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20" />

                <!-- Título -->
                <Label Text="{helpers:TranslateExtension Text='LblConfirmacionRequerida'}"
                       Style="{StaticResource TitleStyle}" />

                <!-- Mensaje de confirmación -->
                <Label x:Name="ConfirmationMessageLabel"
                       Text="Mensaje completo aquí"
                       Style="{StaticResource MessageStyle}" />

                <!-- Botones -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Botón No -->
                    <Frame Grid.Column="0"
                           Style="{StaticResource ButtonFrameStyle}"
                           BackgroundColor="#95A5A6">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNoButtonTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="{helpers:TranslateExtension Text='LabelNo'}"
                               Style="{StaticResource ButtonLabelStyle}"
                               TextColor="White" />
                    </Frame>

                    <!-- Botón Sí -->
                    <Frame Grid.Column="1"
                           x:Name="YesButtonFrame"
                           Style="{StaticResource ButtonFrameStyle}"
                           BackgroundColor="#E74C3C">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnYesButtonTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="{helpers:TranslateExtension Text='LabelSi'}"
                               Style="{StaticResource ButtonLabelStyle}"
                               TextColor="White" />
                    </Frame>
                </Grid>
            </StackLayout>
        </Frame>
    </ContentPage.Content>
</ContentPage>