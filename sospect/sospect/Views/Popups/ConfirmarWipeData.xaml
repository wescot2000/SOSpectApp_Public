<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="True"
    x:Class="sospect.Views.Popups.ConfirmarWipeData">
    <AbsoluteLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <BoxView Color="#C0000000" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All"/>
        <Frame
           AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.9, 0.7"
           AbsoluteLayout.LayoutFlags="All" CornerRadius="10"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           BackgroundColor="White"
           WidthRequest="400"
           HeightRequest="500"
           Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Column="0"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       TextColor="Black"
                       Text="{helpers:TranslateExtension Text='LblAtencion'}"
                       FontAttributes="Bold"
                       FontSize="Medium"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="0"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       TextColor="Black"
                       Text="{helpers:TranslateExtension Text='AdverBorradoDatos'}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="0"
                       Grid.Row="2"
                       Margin="0,30,0,0"
                       TextColor="Black"
                       Grid.ColumnSpan="2"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       Text="{helpers:TranslateExtension Text='ConfirmarBorradoDatosUsuario'}"/>
                <Frame Grid.Column="0"
                   Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Margin="0,10,0,0"
                   Padding="1"
                   BorderColor="Gray"
                   CornerRadius="5"
                   BackgroundColor="White"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="Center">
                    <Entry HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       Placeholder="{helpers:TranslateExtension Text='ColoqueSuIDUsuario'}"
                       Text="{Binding UsuarioIdIngresado}"
                       TextColor="Black"
                       BackgroundColor="White"
                       WidthRequest="500"
                       HorizontalTextAlignment="Center"/>
                </Frame>
                <Button Grid.Column="0"
                    Margin="0,30,0,0"
                    Grid.Row="4"
                    Text="{helpers:TranslateExtension Text='LabelOK'}"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#1465bb"
                    VerticalOptions="Center"
                    Command="{Binding ConfirmarWipeData}"
                    TextColor="White"/>
                <Button Grid.Column="1"
                    Margin="0,30,0,0"
                    Grid.Row="4"
                    Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding CancelarCommand}"
                    VerticalOptions="Center"
                    BackgroundColor="#1465bb"
                    TextColor="White"/>
            </Grid>
        </Frame>
    </AbsoluteLayout>
</toolkit:Popup>