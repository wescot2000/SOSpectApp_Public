<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    CanBeDismissedByTappingOutsideOfPopup="True"
    x:Class="sospect.Views.Popups.RelationshipPickerPopup"
    x:Name="popup">

    <Frame CornerRadius="15"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           BackgroundColor="White"
           Padding="0"
           HasShadow="True"
           WidthRequest="320"
           MaximumHeightRequest="500">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    BackgroundColor="#4A90E2" 
                    StrokeThickness="0"
                    Padding="20,15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15,15,0,0"/>
                </Border.StrokeShape>
                <Label Text="{helpers:TranslateExtension Text='LblRelacionProtegido'}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Lista de tipos de relación -->
            <ScrollView Grid.Row="1" Padding="0">
                <CollectionView ItemsSource="{Binding RelationshipTypes}"
                                SelectionMode="Single"
                                SelectedItem="{Binding RelationshipTypeSelected}"
                                SelectionChangedCommand="{Binding SelectRelationshipCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,15" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Name=popup}, Path=BindingContext.SelectRelationshipCommand}" 
                                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <!-- Efecto visual de selección -->
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeThickness="0"
                                        Opacity="0"
                                        x:Name="SelectionBackground">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" 
                                                   Binding="{Binding Source={x:Reference Name=popup}, Path=BindingContext.RelationshipTypeSelected.TiporelacionId}" 
                                                   Value="{Binding TiporelacionId}">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Label Text="{Binding TranslatedDescription}"
                                       TextColor="#333333"
                                       FontSize="16"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"
                                       Padding="15,12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- Footer con botón cancelar -->
            <Border Grid.Row="2" 
                    BackgroundColor="#F8F9FA" 
                    StrokeThickness="0"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,15,15"/>
                </Border.StrokeShape>
                <Button Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                        BackgroundColor="Transparent"
                        TextColor="#666666"
                        FontSize="16"
                        Clicked="OnCancelTapped"/>
            </Border>
        </Grid>
    </Frame>
</toolkit:Popup>