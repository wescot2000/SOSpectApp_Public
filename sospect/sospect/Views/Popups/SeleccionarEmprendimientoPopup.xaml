<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:helpers="clr-namespace:sospect.Helpers"
               x:Class="sospect.Views.Popups.SeleccionarEmprendimientoPopup"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Color="Transparent">

    <Frame BackgroundColor="White"
           CornerRadius="16"
           Padding="0"
           HasShadow="True"
           WidthRequest="340"
           MaximumHeightRequest="500">
        <StackLayout Spacing="0">

            <!-- Encabezado -->
            <StackLayout Padding="20,20,20,12" Spacing="4"
                         BackgroundColor="#F8F9FA">
                <Label Text="{helpers:TranslateExtension Text='LblSeleccionaEmprendimiento'}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#2C3E50"
                       HorizontalTextAlignment="Center"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="#E0E0E0"
                         Margin="0,8,0,0"/>
            </StackLayout>

            <!-- Lista de emprendimientos -->
            <ScrollView MaximumHeightRequest="320">
                <StackLayout x:Name="ListaEmprendimientos"
                             Spacing="0"
                             Padding="8,4"/>
            </ScrollView>

            <!-- Botón cancelar -->
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
            <Button x:Name="BtnCancelar"
                    Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                    BackgroundColor="White"
                    TextColor="#E74C3C"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="48"
                    Clicked="OnCancelarClicked"/>

        </StackLayout>
    </Frame>

</toolkit:Popup>
