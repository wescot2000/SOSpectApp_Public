<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    CanBeDismissedByTappingOutsideOfPopup="True"
    x:Class="sospect.Views.Popups.CriteriosGestionPopup"
    x:Name="popup">

    <Frame CornerRadius="15"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           BackgroundColor="White"
           Padding="0"
           HasShadow="True"
           WidthRequest="420">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#1465bb"
                    StrokeThickness="0"
                    Padding="20,15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15,15,0,0"/>
                </Border.StrokeShape>
                <Label Text="{helpers:TranslateExtension Text='LblCriteriosGestionTitulo'}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Criterios -->
            <StackLayout Grid.Row="1" Padding="20,20,20,10" Spacing="14">

                <!-- Criterio 1: Base = historial de cumplimiento -->
                <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="📋"
                           FontSize="20"
                           VerticalTextAlignment="Start"/>
                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LblCriterioBaseHistorial'}"
                           FontSize="13"
                           TextColor="#2C3E50"
                           LineBreakMode="WordWrap"/>
                </Grid>

                <!-- Criterio 2: Penalización por abiertas actuales -->
                <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="🔴"
                           FontSize="20"
                           VerticalTextAlignment="Start"/>
                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LblCriterioPenalizacionAbiertas'}"
                           FontSize="13"
                           TextColor="#2C3E50"
                           LineBreakMode="WordWrap"/>
                </Grid>

                <!-- Criterio 3: Score 0-100 -->
                <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="📊"
                           FontSize="20"
                           VerticalTextAlignment="Start"/>
                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LblCriterioScoreFinal'}"
                           FontSize="13"
                           TextColor="#2C3E50"
                           LineBreakMode="WordWrap"/>
                </Grid>

            </StackLayout>

            <!-- Botón Cerrar -->
            <Border Grid.Row="2"
                    BackgroundColor="#F8F9FA"
                    StrokeThickness="0"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,15,15"/>
                </Border.StrokeShape>
                <Button Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                        BackgroundColor="#1465bb"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Clicked="OnCerrarTapped"/>
            </Border>
        </Grid>
    </Frame>
</toolkit:Popup>
