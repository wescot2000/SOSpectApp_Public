<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False"
    x:Class="sospect.Views.Popups.WipeDataPopup">

    <Frame BackgroundColor="White"
           CornerRadius="16"
           HasShadow="True"
           Padding="24"
           WidthRequest="380"
           MaximumWidthRequest="400"
           BorderColor="Transparent">

        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ícono de advertencia -->
            <Label Grid.Row="0"
                   Text="{x:Static fonts:IconFont.TriangleExclamation}"
                   FontFamily="{StaticResource IcoMoonFamily}"
                   FontSize="50"
                   TextColor="#E74C3C"
                   HorizontalOptions="Center"/>

            <!-- Título -->
            <Label Grid.Row="1"
                   Text="{helpers:TranslateExtension Text='LblAtencion'}" 
                   FontAttributes="Bold"
                   FontSize="20"
                   TextColor="#2C3E50"
                   HorizontalTextAlignment="Center"/>

            <!-- Advertencia -->
            <Label Grid.Row="2"
                   Text="{helpers:TranslateExtension Text='AdverBorradoDatos'}"
                   TextColor="#7F8C8D"
                   FontSize="15"
                   LineHeight="1.4"
                   HorizontalTextAlignment="Center"/>

            <!-- Confirmación -->
            <Label Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{helpers:TranslateExtension Text='ConfirmarBorradoDatosUsuario'}"
                   TextColor="#2C3E50"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <!-- Campo de entrada -->
            <Frame Grid.Row="4"
                   Margin="0,8,0,0"
                   Padding="0" 
                   BorderColor="#E0E0E0" 
                   CornerRadius="8" 
                   BackgroundColor="White"
                   HasShadow="False">
                <Entry Placeholder="{helpers:TranslateExtension Text='ColoqueSuIDUsuario'}"
                       Text="{Binding UsuarioIdIngresado}"
                       TextColor="#2C3E50"
                       PlaceholderColor="#BDC3C7"
                       BackgroundColor="Transparent"
                       FontSize="15"
                       Margin="12,8"
                       HorizontalTextAlignment="Center"/>
            </Frame>

            <!-- Botones -->
            <Grid Grid.Row="5" 
                  Margin="0,16,0,0"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Cancelar -->
                <Frame Grid.Column="0"
                       Padding="0"
                       CornerRadius="10"
                       BackgroundColor="#95A5A6"
                       HasShadow="True"
                       BorderColor="Transparent"
                       HeightRequest="50">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelarCommand}"/>
                    </Frame.GestureRecognizers>
                    <Label Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Botón Confirmar -->
                <Frame Grid.Column="1"
                       Padding="0"
                       CornerRadius="10"
                       BackgroundColor="#E74C3C"
                       HasShadow="True"
                       BorderColor="Transparent"
                       HeightRequest="50">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConfirmarWipeData}"/>
                    </Frame.GestureRecognizers>
                    <Label Text="{helpers:TranslateExtension Text='LabelOK'}"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
            </Grid>

        </Grid>

    </Frame>
</toolkit:Popup>