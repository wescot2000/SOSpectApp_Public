<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
    x:Class="sospect.Views.Popups.SuperPowersPopupPage"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <toolkit:Popup.Resources>
        <ResourceDictionary>
            <Style x:Key="SuperPowerMenuItemStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,8" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="MinimumHeightRequest" Value="70" />
            </Style>

            <Style x:Key="SuperPowerIconStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource IcoMoonFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="#9B59B6" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="WidthRequest" Value="50" />
            </Style>

            <Style x:Key="SuperPowerTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#2C3E50" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="MaxLines" Value="2" />
            </Style>

            <Style x:Key="SuperPowerCloseButtonStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#E74C3C" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,16,0,0" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>

            <Style x:Key="SuperPowerHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#9B59B6" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SuperPowerSubHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#7F8C8D" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
        </ResourceDictionary>
    </toolkit:Popup.Resources>

    <Grid>
        <!-- Fondo semi-transparente -->
        <BoxView Color="#80000000" />

        <!-- Contenedor principal del popup -->
        <Frame BackgroundColor="#F8F9FA" 
               HasShadow="True" 
               CornerRadius="20" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" 
               WidthRequest="350"
               Padding="0"
               BorderColor="Transparent">

            <StackLayout Spacing="0" Padding="20">

                <!-- Header -->
                <StackLayout Spacing="4" Margin="0,0,0,20">
                    <Label Text="{helpers:TranslateExtension Text='LblPoderesSospect'}" 
                               Style="{StaticResource SuperPowerHeaderStyle}" />
                    <Label Text="{helpers:TranslateExtension Text='LblOpcionesPoderes'}" 
                               Style="{StaticResource SuperPowerSubHeaderStyle}" />
                </StackLayout>

                <!-- Opciones del menú -->
                <StackLayout Spacing="0">

                    <!-- Suscripciones y costos -->
                    <Frame Style="{StaticResource SuperPowerMenuItemStyle}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowSubscriptionOptionsCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" 
                                       Text="{x:Static fonts:IconFont.Info}"
                                       Style="{StaticResource SuperPowerIconStyle}" />
                            <Label Grid.Column="1" 
                                       Text="{helpers:TranslateExtension Text='LblSubscripcionesCosto'}"
                                       Style="{StaticResource SuperPowerTextStyle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Frame>

                    <!-- Comprar poderes -->
                    <Frame Style="{StaticResource SuperPowerMenuItemStyle}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PurchaseSuperPowersCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" 
                                       Text="{x:Static fonts:IconFont.CreditCard}"
                                       Style="{StaticResource SuperPowerIconStyle}" />
                            <Label Grid.Column="1" 
                                       Text="{helpers:TranslateExtension Text='LblQuieroComprar'}"
                                       Style="{StaticResource SuperPowerTextStyle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Frame>
                </StackLayout>

                <!-- Botón Cerrar -->
                <Frame Style="{StaticResource SuperPowerCloseButtonStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" 
                                   Text="{x:Static fonts:IconFont.UserSecret}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="20"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                        <Label Grid.Column="1" 
                                   Text="{helpers:TranslateExtension Text='OptVolver'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                    </Grid>
                </Frame>

            </StackLayout>
        </Frame>
    </Grid>
</toolkit:Popup>