<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:cam="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    x:Class="sospect.Views.Popups.CameraPopup">

    <Frame CornerRadius="20"
           BackgroundColor="Black"
           Padding="0"
           HasShadow="True"
           WidthRequest="400"
           HeightRequest="600"
           HorizontalOptions="Center"
           VerticalOptions="Center">

        <Grid BackgroundColor="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Vista previa de la cámara (Camera.MAUI) -->
            <cam:CameraView x:Name="cameraView"
                           Grid.Row="0"
                           VerticalOptions="FillAndExpand"
                           HorizontalOptions="FillAndExpand"/>

            <!-- Controles inferiores -->
            <Grid Grid.Row="1"
                  BackgroundColor="#80000000"
                  Padding="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Cancelar -->
                <Button Grid.Column="0"
                        Text="{helpers:TranslateExtension Text='LblCerrarCamara'}"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        Clicked="OnCancelClicked"
                        WidthRequest="80"
                        HeightRequest="60"/>

                <!-- Botón Capturar -->
                <Border Grid.Column="1"
                        StrokeThickness="4"
                        Stroke="White"
                        BackgroundColor="White"
                        WidthRequest="70"
                        HeightRequest="70"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="35"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCaptureClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Espaciador -->
                <BoxView Grid.Column="2" IsVisible="False"/>
            </Grid>

            <!-- Overlay de procesamiento -->
            <Grid x:Name="processingOverlay"
                  Grid.RowSpan="2"
                  BackgroundColor="#CC000000"
                  IsVisible="False"
                  VerticalOptions="FillAndExpand"
                  HorizontalOptions="FillAndExpand">

                <VerticalStackLayout VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Spacing="20">

                    <ActivityIndicator IsRunning="True"
                                      Color="White"
                                      WidthRequest="50"
                                      HeightRequest="50"/>

                    <Label Text="{helpers:TranslateExtension Text='LblProcesandoFoto'}"
                           TextColor="White"
                           FontSize="16"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Frame>
</toolkit:Popup>
