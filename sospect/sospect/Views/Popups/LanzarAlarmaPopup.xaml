<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:converters="clr-namespace:sospect.Converters"
    CanBeDismissedByTappingOutsideOfPopup="False"
    x:Class="sospect.Views.Popups.LanzarAlarmaPopup">
    <Frame CornerRadius="10"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           WidthRequest="400"
           Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Column="0"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="{helpers:TranslateExtension Text='LabelAlarma'}"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"/>
            <Label Grid.Column="0"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{helpers:TranslateExtension Text='notificacionurgente'}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"/>
            <Label Grid.Column="0"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="{Binding CuentaRegresivaAlarma}"
                   FontSize="30"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Grid.Column="0"
                    Grid.Row="3"
                    Text="{helpers:TranslateExtension Text='LabelOK'}"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#1465bb"
                    VerticalOptions="Center"
                    Command="{Binding RegistrarAlarmaCommand}"
                    IsVisible="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                    TextColor="White"/>
            <Button Grid.Column="1"
                    Grid.Row="3"
                    Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                    HeightRequest="50"
                    CornerRadius="25"
                    Clicked="CancelarAlarma"
                    VerticalOptions="Center"
                    BackgroundColor="#1465bb"
                    TextColor="White"/>
        </Grid>
    </Frame>
</toolkit:Popup>

