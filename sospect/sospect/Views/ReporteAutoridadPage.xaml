<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    xmlns:converters="clr-namespace:sospect.Converters"
    xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    x:Class="sospect.Views.ReporteAutoridadPage"
    BackgroundColor="#F8F9FA"
    Title="{helpers:TranslateExtension Text='LblTituloReporteAutoridad'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:SKColorToXamarinColorConverter x:Key="ColorConverter" />
            <converters:StarRatingConverter x:Key="StarRatingConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView IsVisible="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
            <StackLayout Spacing="12" Padding="16">

                <!-- ─── Header: foto + nombre + cargo + territorio ───────── -->
                <Border BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout Spacing="10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Foto circular -->
                            <Border Grid.Column="0"
                                    StrokeShape="Ellipse"
                                    StrokeThickness="0"
                                    HeightRequest="56"
                                    WidthRequest="56"
                                    BackgroundColor="#E8E8E8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding TieneFoto}">
                                <Image Source="{Binding FotoUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="56"
                                       WidthRequest="56" />
                            </Border>

                            <!-- Placeholder cuando no hay foto -->
                            <Border Grid.Column="0"
                                    StrokeShape="Ellipse"
                                    StrokeThickness="0"
                                    HeightRequest="56"
                                    WidthRequest="56"
                                    BackgroundColor="#D6E4F0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding TieneFoto, Converter={StaticResource InverseBooleanConverter}}">
                                <Label Text="{x:Static fonts:IconFont.UserTie}"
                                       FontFamily="{StaticResource IcoMoonFamily}"
                                       FontSize="28"
                                       TextColor="#1A6FB4"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Cargo, nombre y territorio -->
                            <StackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                                <Label Text="{Binding CargoNombre}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#1A6FB4" />
                                <Label Text="{Binding NombreCompleto}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TerritorioNombre}"
                                       FontSize="12"
                                       TextColor="#7F8C8D"
                                       LineBreakMode="TailTruncation" />
                            </StackLayout>
                        </Grid>

                        <!-- Nota: datos actualizados diariamente -->
                        <Label Text="{helpers:TranslateExtension Text='LblReporteAutoridadNota'}"
                               FontSize="11"
                               TextColor="#BDC3C7"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <!-- ─── Calificación ciudadana (1-5 estrellas) ───────────── -->
                <Border BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout Spacing="10">

                        <Label Text="{helpers:TranslateExtension Text='LblCalificaGestionPolitico'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <!-- 5 estrellas: color dorado si CalificacionActual >= NumeroEstrella -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,4">

                            <!-- Estrella 1 -->
                            <Label Text="{x:Static fonts:IconFont.Star}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="34"
                                   TextColor="{Binding CalificacionActual,
                                               Converter={StaticResource StarRatingConverter},
                                               ConverterParameter='1'}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalificarCommand}" CommandParameter="1" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Estrella 2 -->
                            <Label Text="{x:Static fonts:IconFont.Star}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="34"
                                   TextColor="{Binding CalificacionActual,
                                               Converter={StaticResource StarRatingConverter},
                                               ConverterParameter='2'}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalificarCommand}" CommandParameter="2" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Estrella 3 -->
                            <Label Text="{x:Static fonts:IconFont.Star}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="34"
                                   TextColor="{Binding CalificacionActual,
                                               Converter={StaticResource StarRatingConverter},
                                               ConverterParameter='3'}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalificarCommand}" CommandParameter="3" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Estrella 4 -->
                            <Label Text="{x:Static fonts:IconFont.Star}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="34"
                                   TextColor="{Binding CalificacionActual,
                                               Converter={StaticResource StarRatingConverter},
                                               ConverterParameter='4'}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalificarCommand}" CommandParameter="4" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Estrella 5 -->
                            <Label Text="{x:Static fonts:IconFont.Star}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="34"
                                   TextColor="{Binding CalificacionActual,
                                               Converter={StaticResource StarRatingConverter},
                                               ConverterParameter='5'}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalificarCommand}" CommandParameter="5" />
                                </Label.GestureRecognizers>
                            </Label>

                        </HorizontalStackLayout>

                        <!-- Resultados del cron diario: aprobación promedio + votantes -->
                        <BoxView HeightRequest="1" BackgroundColor="#E8E8E8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{helpers:TranslateExtension Text='LblAprobacionCiudadana'}"
                                   FontSize="13"
                                   TextColor="#7F8C8D"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PctAprobacionTexto}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#F39C12"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{helpers:TranslateExtension Text='LblVotantesAprobacion'}"
                                   FontSize="13"
                                   TextColor="#7F8C8D"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding CntVotantesTexto}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"
                                   VerticalOptions="Center" />
                        </Grid>

                    </StackLayout>
                </Border>

                <!-- ─── Botón: Ver ranking de políticos locales ──────────── -->
                <Border BackgroundColor="#1A6FB4"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VerRankingCommand}" />
                    </Border.GestureRecognizers>
                    <Grid Padding="16,14" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{x:Static fonts:IconFont.RankingStar}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="20"
                               TextColor="White"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{helpers:TranslateExtension Text='LblVerRankingPoliticos'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="{x:Static fonts:IconFont.ChevronRight}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="16"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ─── Gráfico de pastel: distribución por tipo ─────────── -->
                <Border BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout Spacing="12">
                        <Label Text="{helpers:TranslateExtension Text='LblTiposDeAlarma'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <charts:ChartView
                            HeightRequest="280"
                            WidthRequest="280"
                            HorizontalOptions="Center"
                            Chart="{Binding Chart}" />

                        <!-- Leyenda -->
                        <CollectionView ItemsSource="{Binding TiposAlarma}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout Spacing="0">
                                        <Grid Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <BoxView Grid.Column="0"
                                                     WidthRequest="12"
                                                     HeightRequest="12"
                                                     CornerRadius="6"
                                                     Color="{Binding Color, Converter={StaticResource ColorConverter}}"
                                                     VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding DescripcionTraducida}"
                                                   FontSize="13"
                                                   TextColor="#2C3E50"
                                                   VerticalTextAlignment="Center"
                                                   Margin="6,0,0,0" />

                                            <Label Grid.Column="2"
                                                   Text="{Binding Pct}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#2C3E50"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" BackgroundColor="#E8E8E8" />
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>

                <!-- ─── Grid 2×2: Abiertas / Cerradas / Likes / Reenvíos ── -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Alarmas abiertas -->
                    <Border Grid.Column="0" Grid.Row="0"
                            BackgroundColor="White"
                            Stroke="#E8E8E8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <StackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static fonts:IconFont.CircleExclamation}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="24"
                                   TextColor="#E74C3C"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CntAbiertas}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#E74C3C"
                                   HorizontalOptions="Center" />
                            <Label Text="{helpers:TranslateExtension Text='LblAlarmasAbiertas'}"
                                   FontSize="11"
                                   TextColor="#7F8C8D"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </Border>

                    <!-- Alarmas cerradas -->
                    <Border Grid.Column="1" Grid.Row="0"
                            BackgroundColor="White"
                            Stroke="#E8E8E8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <StackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static fonts:IconFont.CircleCheck}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="24"
                                   TextColor="#27AE60"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CntCerradas}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#27AE60"
                                   HorizontalOptions="Center" />
                            <Label Text="{helpers:TranslateExtension Text='LblAlarmasCerradas'}"
                                   FontSize="11"
                                   TextColor="#7F8C8D"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </Border>

                    <!-- Likes -->
                    <Border Grid.Column="0" Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E8E8E8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <StackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static fonts:IconFont.ThumbsUp}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="24"
                                   TextColor="#3498DB"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CntLikes}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#3498DB"
                                   HorizontalOptions="Center" />
                            <Label Text="{helpers:TranslateExtension Text='LblLikes'}"
                                   FontSize="11"
                                   TextColor="#7F8C8D"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </Border>

                    <!-- Reenvíos -->
                    <Border Grid.Column="1" Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E8E8E8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <StackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static fonts:IconFont.ShareNodes}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="24"
                                   TextColor="#9B59B6"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CntReenvios}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#9B59B6"
                                   HorizontalOptions="Center" />
                            <Label Text="{helpers:TranslateExtension Text='LblReenvios'}"
                                   FontSize="11"
                                   TextColor="#7F8C8D"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </Border>
                </Grid>

                <!-- ─── Card: Tiempo promedio de resolución ─────────────── -->
                <Border BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout Spacing="6">
                        <Label Text="{helpers:TranslateExtension Text='LblTiempoPromedioResolucion'}"
                               FontSize="14"
                               TextColor="#7F8C8D" />
                        <StackLayout Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding AvgDiasResolucion}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50" />
                            <Label Text="{helpers:TranslateExtension Text='LblDias'}"
                                   FontSize="14"
                                   TextColor="#7F8C8D"
                                   VerticalOptions="End"
                                   Margin="0,0,0,4" />
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- ─── Card: Tasa de resolución con barra de progreso ──── -->
                <Border BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{helpers:TranslateExtension Text='LblResolucion'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PctResolucionTexto}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#27AE60"
                                   VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding PctResolucionDecimal}"
                                     ProgressColor="#27AE60"
                                     HeightRequest="8" />
                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid BackgroundColor="#80000000"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="#4A90E2"
                               IsRunning="{Binding IsRunning}" />
        </Grid>
    </Grid>

</ContentPage>
