<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.Views.AprobarSolicitudesPage"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             BackgroundColor="#F8F9FA"
             Title="{helpers:TranslateExtension Text='AprobarSolicitudes'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SolicitudCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="16,8" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <Style x:Key="LabelHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#7F8C8D" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="LabelValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#2C3E50" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <Style x:Key="ActionButtonLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#7F8C8D" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="20" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Lista de solicitudes -->
        <ScrollView Grid.Row="0" IsVisible="{Binding IsListEmpty, Converter={StaticResource InverseBooleanConverter}}">
            <StackLayout Spacing="0" Padding="0,8">
                <CollectionView x:Name="SolicitudesListView" 
                                ItemsSource="{Binding Solicitudes}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource SolicitudCardStyle}">
                                <StackLayout Spacing="8">
                                    <!-- Usuario solicitante -->
                                    <StackLayout Spacing="4">
                                        <Label Text="{helpers:TranslateExtension Text='LblUsuarioSolicitante'}"
                                               Style="{StaticResource LabelHeaderStyle}" />
                                        <Label Text="{Binding login}"
                                               Style="{StaticResource LabelValueStyle}" />
                                    </StackLayout>

                                    <!-- Fecha solicitud -->
                                    <StackLayout Spacing="4">
                                        <Label Text="{helpers:TranslateExtension Text='LblFechaSolicitud'}"
                                               Style="{StaticResource LabelHeaderStyle}" />
                                        <Label Text="{Binding fecha_solicitud}"
                                               Style="{StaticResource LabelValueStyle}" />
                                    </StackLayout>

                                    <!-- Separador -->
                                    <BoxView HeightRequest="1" 
                                             BackgroundColor="#E8E8E8" 
                                             Margin="0,8" />

                                    <!-- Acción a realizar -->
                                    <Label Text="{helpers:TranslateExtension Text='LblAccionRealizar'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,4,0,12" />

                                    <!-- Botones de acción -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Botón Aprobar -->
                                        <Frame Grid.Column="0"
                                               Style="{StaticResource ActionButtonStyle}"
                                               BackgroundColor="#27AE60">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.AprobarCommand, Source={x:Reference SolicitudesListView}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Label Text="{helpers:TranslateExtension Text='LabelAprobar'}"
                                                   Style="{StaticResource ActionButtonLabelStyle}"
                                                   TextColor="White" />
                                        </Frame>

                                        <!-- Botón Rechazar -->
                                        <Frame Grid.Column="1"
                                               Style="{StaticResource ActionButtonStyle}"
                                               BackgroundColor="#E74C3C">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.RechazarCommand, Source={x:Reference SolicitudesListView}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Label Text="{helpers:TranslateExtension Text='LabelRechazar'}"
                                                   Style="{StaticResource ActionButtonLabelStyle}"
                                                   TextColor="White" />
                                        </Frame>
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Estado vacío -->
        <StackLayout Grid.Row="0" 
                     IsVisible="{Binding IsListEmpty}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Padding="40">
            <Label Text="{x:Static fonts:IconFont.Inbox}"
                   FontFamily="{StaticResource IcoMoonFamily}"
                   FontSize="64"
                   TextColor="#BDC3C7"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16" />
            <Label Text="{helpers:TranslateExtension Text='LblNoHayRegistros'}"
                   Style="{StaticResource EmptyStateLabelStyle}" />
        </StackLayout>

        <!-- Loading overlay -->
        <Grid Grid.Row="0" 
              BackgroundColor="#80000000"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="#4A90E2"
                               IsRunning="{Binding IsRunning}" />
        </Grid>
    </Grid>
</ContentPage>