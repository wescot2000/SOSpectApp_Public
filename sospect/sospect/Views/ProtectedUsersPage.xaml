<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.Views.ProtectedUsersPage"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             BackgroundColor="#F8F9FA"
             Title="{helpers:TranslateExtension Text='LblProtegidos'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="BorderColor" Value="Transparent"/>
            </Style>

            <Style x:Key="LabelTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#7F8C8D"/>
            </Style>

            <Style x:Key="LabelValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="#2C3E50"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <StackLayout Spacing="0" Padding="0,8">

                    <Frame Style="{StaticResource CardStyle}" Margin="16,8,16,16">
                        <StackLayout Spacing="12">
                            <Label Text="{x:Static fonts:IconFont.User}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="40"
                               TextColor="#4A90E2"
                               HorizontalOptions="Center"/>
                            <Label Text="{helpers:TranslateExtension Text='LblProtegidos'}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#4A90E2"
                               HorizontalTextAlignment="Center"/>
                            </StackLayout>
                    </Frame>

                    <!-- Lista -->
                    <ListView x:Name="ProtectedUsersListView"
                              BackgroundColor="Transparent"
                              HasUnevenRows="True"
                              ItemsSource="{Binding ProtectedUsers}"
                              SelectionMode="None"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame Padding="16" 
                                           Margin="16,0,16,12" 
                                           CornerRadius="12" 
                                           BackgroundColor="White" 
                                           HasShadow="True"
                                           BorderColor="Transparent">
                                        <StackLayout Spacing="12">

                                            <!-- Usuario Protegido -->
                                            <StackLayout Spacing="4">
                                                <Label Text="{helpers:TranslateExtension Text='LblUsuarioProtegido'}"
                                                       Style="{StaticResource LabelTitleStyle}"/>
                                                <Label Text="{Binding User_Id_ThirdParty_Protegido}"
                                                       Style="{StaticResource LabelValueStyle}"/>
                                            </StackLayout>

                                            <!-- Login -->
                                            <StackLayout Spacing="4">
                                                <Label Text="{helpers:TranslateExtension Text='LabelUsuario'}"
                                                       Style="{StaticResource LabelTitleStyle}"/>
                                                <Label Text="{Binding Login_Protegido}"
                                                       Style="{StaticResource LabelValueStyle}"/>
                                            </StackLayout>

                                            <!-- Fechas en Grid -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <StackLayout Spacing="4" Grid.Column="0">
                                                    <Label Text="{helpers:TranslateExtension Text='LblFechaActivacion'}"
                                                           Style="{StaticResource LabelTitleStyle}"/>
                                                    <Label Text="{Binding Fecha_Activacion, StringFormat='{0:yyyy-MM-dd}'}"
                                                           Style="{StaticResource LabelValueStyle}"/>
                                                </StackLayout>

                                                <StackLayout Spacing="4" Grid.Column="1">
                                                    <Label Text="{helpers:TranslateExtension Text='LblFechaFinalizacion'}"
                                                           Style="{StaticResource LabelTitleStyle}"/>
                                                    <Label Text="{Binding Fecha_Finalizacion, StringFormat='{0:yyyy-MM-dd}'}"
                                                           Style="{StaticResource LabelValueStyle}"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Separador -->
                                            <BoxView HeightRequest="1"
                                                     BackgroundColor="#E0E0E0"
                                                     Margin="0,8,0,8"/>

                                            <!-- Botón Eliminar -->
                                            <Frame BackgroundColor="#E74C3C"
                                                   Padding="16"
                                                   HeightRequest="60"
                                                   CornerRadius="12"
                                                   HasShadow="False"
                                                   BorderColor="Transparent">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ProtectedUsersListView}, Path=BindingContext.DeleteProtectedUserCommand}" 
                                                                          CommandParameter="{Binding .}"/>
                                                </Frame.GestureRecognizers>
                                                <Label Text="{helpers:TranslateExtension Text='LblEliminarProtegido'}"
                                                       TextColor="White"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="Center"/>
                                            </Frame>

                                        </StackLayout>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Mensaje de lista vacía -->
                    <Frame x:Name="EmptyListFrame"
                            Style="{StaticResource CardStyle}"
                            Margin="16,40,16,16"
                            IsVisible="{Binding IsListEmpty}">
                            <StackLayout Spacing="16">
                                <Label Text="{x:Static fonts:IconFont.Shield}"
                    FontFamily="{StaticResource IcoMoonFamily}"
                    FontSize="60"
                    TextColor="#BDC3C7"
                    HorizontalOptions="Center"/>
                                <Label Text="{helpers:TranslateExtension Text='LblNoHayRegistros'}"
                    FontSize="16"
                    TextColor="#7F8C8D"
                    HorizontalTextAlignment="Center"/>
                            </StackLayout>
                    </Frame>

                </StackLayout>
            </ScrollView>

            <!-- Loading -->
            <Grid BackgroundColor="Black"
                  Opacity="0.5"
                  IsVisible="{Binding IsRunning}">
                <ActivityIndicator VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   HeightRequest="50"
                                   WidthRequest="50"
                                   Color="#4A90E2"
                                   IsRunning="{Binding IsRunning}"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>