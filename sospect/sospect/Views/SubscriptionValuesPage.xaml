<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.Views.SubscriptionValuesPage"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             BackgroundColor="#F8F9FA"
             Title="{helpers:TranslateExtension Text='LblValoresSubsc'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderContainerStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#4A90E2" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="20,20,20,10" />
                <Setter Property="HasShadow" Value="True" />
            </Style>

            <Style x:Key="SubscriptionCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Margin" Value="20,8,20,8" />
                <Setter Property="HasShadow" Value="True" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0">

                <!-- Header con título e icono -->
                <Frame Style="{StaticResource HeaderContainerStyle}">
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               Text="{x:Static fonts:IconFont.CreditCard}"
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{helpers:TranslateExtension Text='LblSuscripcionesDisponibles'}"
                               TextColor="White"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Frame>

                <!-- Lista de suscripciones -->
                <CollectionView ItemsSource="{Binding SubscriptionValues}"
                               SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource SubscriptionCardStyle}">
                                <Grid ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono decorativo -->
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#E8F4FD"
                                           BorderColor="Transparent"
                                           CornerRadius="8"
                                           Padding="12"
                                           HasShadow="False"
                                           VerticalOptions="Center">
                                        <Label FontFamily="{StaticResource IcoMoonFamily}"
                                               Text="{x:Static fonts:IconFont.Check}"
                                               FontSize="24"
                                               TextColor="#4A90E2"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Frame>

                                    <!-- Texto de la suscripción -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Texto}"
                                           TextColor="#2C3E50"
                                           FontSize="15"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="20" Color="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid BackgroundColor="Black"
              Opacity="0.5"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50"
                             Color="#4A90E2"
                             IsRunning="{Binding IsRunning}" />
        </Grid>
    </Grid>
</ContentPage>