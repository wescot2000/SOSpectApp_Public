<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             BackgroundColor="#F8F9FA"
             x:Class="sospect.Views.ListarMiRedConfianzaPage"
             Title="{helpers:TranslateExtension Text='LabelListarRedConfianzaTitle'}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="16,8"/>
                <Setter Property="BorderColor" Value="Transparent"/>
            </Style>

            <Style x:Key="LabelTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#7F8C8D"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="LabelValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="#2C3E50"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0" Padding="0,8">

                <!-- Header informativo -->
                <Frame Style="{StaticResource CardStyle}" Margin="16,8,16,16">
                    <StackLayout Spacing="12">
                        <Label Text="{x:Static fonts:IconFont.Users}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="36"
                               TextColor="#4A90E2"
                               HorizontalOptions="Center"/>
                        <Label Text="{helpers:TranslateExtension Text='LabelListarRedConfianzaTitle'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Lista de usuarios -->
                <ListView x:Name="UsuariosRedConfianzaListView" 
                          BackgroundColor="Transparent"
                          ItemsSource="{Binding UsuariosRedConfianza}" 
                          HasUnevenRows="True" 
                          SelectionMode="None"
                          SeparatorVisibility="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame Style="{StaticResource CardStyle}">
                                    <StackLayout Spacing="12">

                                        <!-- Nickname (destacado) -->
                                        <Frame BackgroundColor="#E8F4FD"
                                               BorderColor="Transparent"
                                               CornerRadius="8"
                                               Padding="12,8"
                                               HasShadow="False"
                                               Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0"
                                                       Text="{helpers:TranslateExtension Text='LabelNickname'}"
                                                       Style="{StaticResource LabelTitleStyle}"
                                                       TextColor="#3498DB"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Nickname}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#3498DB"
                                                       LineBreakMode="WordWrap"/>
                                            </Grid>
                                        </Frame>

                                        <!-- Nombres -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" 
                                                   Text="{helpers:TranslateExtension Text='LabelNombres'}" 
                                                   Style="{StaticResource LabelTitleStyle}"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Nombres}" 
                                                   Style="{StaticResource LabelValueStyle}"/>
                                        </Grid>

                                        <!-- Apellidos -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" 
                                                   Text="{helpers:TranslateExtension Text='LabelApellidos'}" 
                                                   Style="{StaticResource LabelTitleStyle}"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Apellidos}" 
                                                   Style="{StaticResource LabelValueStyle}"/>
                                        </Grid>

                                        <!-- Separador visual -->
                                        <BoxView HeightRequest="1" 
                                                 BackgroundColor="#E0E0E0" 
                                                 Margin="0,4"/>

                                        <!-- Número Móvil -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" 
                                                   Text="{helpers:TranslateExtension Text='LabelNumeroMovil'}" 
                                                   Style="{StaticResource LabelTitleStyle}"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding NumeroMovil}" 
                                                   Style="{StaticResource LabelValueStyle}"/>
                                        </Grid>

                                        <!-- Email -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" 
                                                   Text="{helpers:TranslateExtension Text='LabelEmail'}" 
                                                   Style="{StaticResource LabelTitleStyle}"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Email}" 
                                                   Style="{StaticResource LabelValueStyle}"/>
                                        </Grid>

                                        <!-- País -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" 
                                                   Text="{helpers:TranslateExtension Text='LabelPais'}" 
                                                   Style="{StaticResource LabelTitleStyle}"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Pais}" 
                                                   Style="{StaticResource LabelValueStyle}"/>
                                        </Grid>

                                    </StackLayout>
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Mensaje de lista vacía -->
                <Frame x:Name="EmptyListFrame"
                       Style="{StaticResource CardStyle}"
                       Margin="16,40,16,16"
                       IsVisible="{Binding IsListEmpty}">
                    <StackLayout Spacing="16">
                        <Label Text="{x:Static fonts:IconFont.Users}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="60"
                               TextColor="#BDC3C7"
                               HorizontalOptions="Center"/>
                        <Label Text="{helpers:TranslateExtension Text='LabelNoHayUsuarioEnRed'}"
                               FontSize="16"
                               TextColor="#7F8C8D"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Indicador de carga -->
        <Grid BackgroundColor="Black"
              Opacity="0.5"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="#4A90E2"
                               IsRunning="{Binding IsRunning}"/>
        </Grid>
    </Grid>
</ContentPage>