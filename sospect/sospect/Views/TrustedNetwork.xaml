<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.Views.TrustedNetwork"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             BackgroundColor="#F8F9FA"
             Title="{helpers:TranslateExtension Text='LabelTitleRedConfianza'}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Card Principal - Información -->
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   BorderColor="Transparent">
                <VerticalStackLayout Padding="24" Spacing="16">

                    <!-- Header con Icono -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#E3F2FD"
                               HasShadow="False"
                               Padding="0"
                               VerticalOptions="Start"
                               BorderColor="Transparent">
                            <Label Text="{x:Static fonts:IconFont.Users}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="24"
                                   TextColor="#4A90E2"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <Label Grid.Column="1"
                               Text="{helpers:TranslateExtension Text='LabelTitleRedConfianza'}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Descripción de Bienvenida -->
                    <Label Text="{helpers:TranslateExtension Text='LabelBienvenidoRedConfianza'}"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           TextColor="#7F8C8D"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Card de Enlaces Informativos -->
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   BorderColor="Transparent">
                <VerticalStackLayout Padding="20" Spacing="0">

                    <!-- Enlace: Quiero saber más -->
                    <Frame Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowMoreInfoCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.Info}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="20"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{helpers:TranslateExtension Text='LabelQuieroSaberMas'}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:IconFont.ChevronRight}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="16"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="12,0"/>

                    <!-- Enlace: Ventajas -->
                    <Frame Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAdvantagesCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.Check}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="20"
                                   TextColor="#27AE60"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{helpers:TranslateExtension Text='LabelVentajasRed'}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:IconFont.ChevronRight}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="16"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="12,0"/>

                    <!-- Enlace: Desventajas -->
                    <Frame Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowDisadvantagesCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.Exclamation}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="20"
                                   TextColor="#E74C3C"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{helpers:TranslateExtension Text='LabelDesventajasRed'}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:IconFont.ChevronRight}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="16"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Botones de Acción Condicionales -->

            <!-- Agregar Datos Básicos -->
            <Frame BackgroundColor="#4A90E2"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="0"
                   MinimumHeightRequest="60"
                   IsVisible="{Binding ShowAddBasicDataButton}"
                   BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddBasicDataCommand}" />
                </Frame.GestureRecognizers>
                <Grid Padding="16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="{x:Static fonts:IconFont.User}"
                           FontFamily="{StaticResource IcoMoonFamily}"
                           FontSize="22"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LabelAgregarDatosBasicos'}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Agregar Usuario a Red -->
            <Frame BackgroundColor="#27AE60"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="0"
                   MinimumHeightRequest="60"
                   IsVisible="{Binding ShowAddUserToTrustedNetworkButton}"
                   BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddUserToTrustedNetworkCommand}" />
                </Frame.GestureRecognizers>
                <Grid Padding="16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="{x:Static fonts:IconFont.Users}"
                           FontFamily="{StaticResource IcoMoonFamily}"
                           FontSize="22"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LabelAgregarUsuarioARed'}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Listar Usuarios en Red -->
            <Frame BackgroundColor="#3498DB"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="0"
                   MinimumHeightRequest="60"
                   IsVisible="{Binding ShowListUsersInTrustedNetworkButton}"
                   BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ListUsersInTrustedNetworkCommand}" />
                </Frame.GestureRecognizers>
                <Grid Padding="16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Text="{x:Static fonts:IconFont.Book}"
                           FontFamily="{StaticResource IcoMoonFamily}"
                           FontSize="22"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{helpers:TranslateExtension Text='LabelListarUsuariosRed'}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>