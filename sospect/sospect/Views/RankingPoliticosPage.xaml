<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:converters="clr-namespace:sospect.Converters"
    xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    x:Class="sospect.Views.RankingPoliticosPage"
    BackgroundColor="#F8F9FA"
    Title="{helpers:TranslateExtension Text='LblRankingPoliticosLocales'}">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E8E8E8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="PoliticoNombreStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#2C3E50" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="PoliticoValorStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Contenido principal -->
        <ScrollView Grid.Row="0"
                    IsVisible="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
            <StackLayout Spacing="0" Padding="16">

                <!-- Descripción -->
                <Label Text="{helpers:TranslateExtension Text='LblRankingDescripcion'}"
                       FontSize="13"
                       TextColor="#7F8C8D"
                       Margin="0,0,0,16" />

                <!-- Selector de métrica (popup personalizado) -->
                <Border Style="{StaticResource CardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirPickerMetricaCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Etiqueta superior -->
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{helpers:TranslateExtension Text='LblSeleccionaMetrica'}"
                               FontSize="12"
                               TextColor="#7F8C8D"
                               Margin="0,0,0,4" />
                        <!-- Nombre de la métrica seleccionada -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding NombreMetricaSeleccionada}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1465bb"
                               VerticalOptions="Center" />
                        <!-- Icono chevron -->
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{x:Static fonts:IconFont.ChevronDown}"
                               FontFamily="IcoMoonFamily"
                               FontSize="18"
                               TextColor="#1465bb"
                               VerticalOptions="Center"
                               HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- Sin datos -->
                <Label Text="{helpers:TranslateExtension Text='LblSinDatos'}"
                       IsVisible="{Binding SinDatos}"
                       FontSize="14"
                       TextColor="#BDC3C7"
                       HorizontalTextAlignment="Center"
                       Margin="0,24,0,0" />

                <!-- Top 5 Mejores -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding HayDatos}">
                    <StackLayout Spacing="0">
                        <!-- Encabezado con ℹ condicional -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                            <Label Grid.Column="0"
                                   Text="{helpers:TranslateExtension Text='LblTop5Mejores'}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   TextColor="#27AE60" />
                            <Label Grid.Column="1"
                                   IsVisible="{Binding EsMetricaScoreGestion}"
                                   Text="&#xebd4;"
                                   FontFamily="IcoMoonFamily"
                                   FontSize="20"
                                   TextColor="#1465bb"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="End"
                                   Margin="8,0,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirCriteriosCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#E8E8E8" Margin="0,0,0,8" />
                        <!-- 2026-04-12: BindableLayout reemplaza CollectionView para iOS.
                             CollectionView dentro de ScrollView no calcula altura en iOS (.NET MAUI known issue).
                             BindableLayout.ItemsSource en un StackLayout no tiene ese problema. -->
                        <StackLayout BindableLayout.ItemsSource="{Binding Top5}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Posición -->
                                        <Label Grid.Column="0"
                                               Text="{Binding Posicion}"
                                               FontSize="13"
                                               TextColor="#27AE60"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center" />

                                        <!-- Nombre -->
                                        <Label Grid.Column="1"
                                               Text="{Binding NombreCompleto}"
                                               Style="{StaticResource PoliticoNombreStyle}" />

                                        <!-- Valor -->
                                        <Label Grid.Column="2"
                                               Text="{Binding ValorTexto}"
                                               Style="{StaticResource PoliticoValorStyle}"
                                               TextColor="#27AE60" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Top 5 Peores -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding HayDatos}">
                    <StackLayout Spacing="0">
                        <Label Text="{helpers:TranslateExtension Text='LblTop5Peores'}"
                               Style="{StaticResource SectionTitleStyle}"
                               TextColor="#E74C3C" />
                        <BoxView HeightRequest="1" BackgroundColor="#E8E8E8" Margin="0,0,0,8" />
                        <!-- 2026-04-12: BindableLayout reemplaza CollectionView (mismo fix que Top5) -->
                        <StackLayout BindableLayout.ItemsSource="{Binding Tail5}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Número -->
                                        <Label Grid.Column="0"
                                               Text="{Binding Posicion}"
                                               FontSize="13"
                                               TextColor="#E74C3C"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center" />

                                        <!-- Nombre -->
                                        <Label Grid.Column="1"
                                               Text="{Binding NombreCompleto}"
                                               Style="{StaticResource PoliticoNombreStyle}" />

                                        <!-- Valor -->
                                        <Label Grid.Column="2"
                                               Text="{Binding ValorTexto}"
                                               Style="{StaticResource PoliticoValorStyle}"
                                               TextColor="#E74C3C" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.Row="0"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsRunning}">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator Color="#4A90E2"
                                   IsRunning="{Binding IsRunning}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                <Label Text="{helpers:TranslateExtension Text='LblCargandoRanking'}"
                       TextColor="White"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </StackLayout>
        </Grid>

        <!-- Banner publicitario -->
        <Grid BackgroundColor="LightGray" Grid.Row="1" HeightRequest="90">
            <admob:BannerAd AdSize="LargeBanner" />
        </Grid>
    </Grid>

</ContentPage>
