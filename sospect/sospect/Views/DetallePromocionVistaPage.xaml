<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             x:Class="sospect.Views.DetallePromocionVistaPage"
             Title="{helpers:TranslateExtension Text='LblDetallePromocion'}"
             BackgroundColor="White">

    <ScrollView>
        <StackLayout Padding="16" Spacing="16">

            <!-- Encabezado: Logo + Nombre del emprendimiento -->
            <StackLayout Spacing="8" HorizontalOptions="Center">

                <!-- Logo del emprendimiento (si habilitado) -->
                <Border x:Name="BorderLogo"
                        StrokeShape="RoundRectangle 60"
                        Stroke="#E0E0E0"
                        StrokeThickness="2"
                        HeightRequest="120"
                        WidthRequest="120"
                        HorizontalOptions="Center"
                        IsVisible="False">
                    <Image x:Name="ImgLogo"
                           Aspect="AspectFill"
                           HeightRequest="120"
                           WidthRequest="120"/>
                </Border>

                <!-- Nombre del emprendimiento -->
                <Label x:Name="LblNombreEmprendimiento"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#212121"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>

                <!-- Chip de fecha de expiración -->
                <Frame x:Name="FrameFechaExpiracion"
                       BackgroundColor="#FFF3E0"
                       BorderColor="#FF9800"
                       CornerRadius="16"
                       Padding="10,4"
                       HasShadow="False"
                       HorizontalOptions="Center"
                       IsVisible="False">
                    <StackLayout Orientation="Horizontal" Spacing="4">
                        <Label Text="⏳" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LblFechaExpiracion"
                               FontSize="13"
                               TextColor="#E65100"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </Frame>

            </StackLayout>

            <!-- Carrusel de fotos de la promoción -->
            <Frame x:Name="FrameFotos"
                   BackgroundColor="White"
                   Padding="0"
                   CornerRadius="12"
                   HasShadow="True"
                   IsVisible="False">
                <CarouselView x:Name="CarouselFotos"
                              HeightRequest="250"
                              HorizontalScrollBarVisibility="Never"
                              IndicatorView="FotosIndicator">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding UrlFoto}"
                                   Aspect="AspectFill"
                                   HeightRequest="250"/>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </Frame>

            <!-- Indicador de fotos -->
            <IndicatorView x:Name="FotosIndicator"
                           HorizontalOptions="Center"
                           IndicatorColor="#CCCCCC"
                           SelectedIndicatorColor="#4CAF50"
                           IsVisible="False"/>

            <!-- Descripción detallada -->
            <Frame BackgroundColor="White"
                   Padding="16"
                   CornerRadius="12"
                   HasShadow="True">
                <StackLayout Spacing="8">
                    <Label Text="{helpers:TranslateExtension Text='LblDescripcion'}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#333"/>
                    <Label x:Name="LblDescripcion"
                           FontSize="14"
                           TextColor="#666"
                           LineBreakMode="WordWrap"/>
                </StackLayout>
            </Frame>

            <!-- Mensaje de la promoción (texto push personalizado) -->
            <Frame x:Name="FrameTextoPush"
                   BackgroundColor="#E3F2FD"
                   BorderColor="#2196F3"
                   Padding="14"
                   CornerRadius="10"
                   HasShadow="False"
                   IsVisible="False">
                <StackLayout Spacing="6">
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <Label Text="🔔" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="{helpers:TranslateExtension Text='LblTextoPush'}"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#1565C0"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    <Label x:Name="LblTextoPush"
                           FontSize="14"
                           TextColor="#1976D2"
                           LineBreakMode="WordWrap"
                           FontAttributes="Italic"/>
                </StackLayout>
            </Frame>

            <!-- Indicador de domicilio disponible -->
            <Frame x:Name="FrameDomicilio"
                   BackgroundColor="#E8F5E9"
                   Padding="12"
                   CornerRadius="8"
                   HasShadow="False"
                   IsVisible="False">
                <StackLayout Orientation="Horizontal" Spacing="8">
                    <Label Text="&#x1F69A;" FontSize="24"/>
                    <Label Text="{helpers:TranslateExtension Text='DeliveryAvailable'}"
                           VerticalOptions="Center"
                           TextColor="#2E7D32"
                           FontAttributes="Bold"
                           FontSize="14"/>
                </StackLayout>
            </Frame>

            <!-- Botón: Contactar al anunciante (visible si contacto_habilitado Y NO soy el creador) -->
            <Button x:Name="BtnContactar"
                    Text="{helpers:TranslateExtension Text='LblContactarAnunciante'}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Clicked="OnContactarClicked"/>

            <!-- Botón: Ir a ventana de chats (visible SOLO si SOY el creador Y contacto_habilitado) -->
            <Button x:Name="BtnVerChats"
                    Text="{helpers:TranslateExtension Text='LblVerChatsPromocion'}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Clicked="OnVerChatsClicked"/>

            <!-- Botón: Ver en mapa (siempre visible) -->
            <Button x:Name="BtnVerEnMapa"
                    Text="{helpers:TranslateExtension Text='ChatVerEnMapa'}"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    Clicked="OnVerEnMapaClicked"/>

            <!-- ActivityIndicator para carga de verificación de términos -->
            <ActivityIndicator x:Name="LoadingTerminos"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#4CAF50"
                               HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>

</ContentPage>
