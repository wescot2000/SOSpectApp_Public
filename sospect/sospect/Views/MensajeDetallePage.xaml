<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
             xmlns:helpers="clr-namespace:sospect.Helpers"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:converters="clr-namespace:sospect.Converters"
             Title="{helpers:TranslateExtension Text='LblMensajes'}"
             BackgroundColor="#F8F9FA"
             x:Class="sospect.Views.MensajeDetallePage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />

            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="16,8"/>
                <Setter Property="BorderColor" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0" VerticalOptions="FillAndExpand">
            <StackLayout Padding="0,8" Spacing="0">

                <!-- Header con ícono del tipo de alarma (si existe) o sobre genérico -->
                <Frame Style="{StaticResource CardStyle}" Margin="16,8,16,16">
                    <StackLayout Spacing="12" HorizontalOptions="Center">
                        <!-- Icono de sobre genérico (broadcast o mensajes sin tipo) -->
                        <Label Text="{x:Static fonts:IconFont.Envelope}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="36"
                               TextColor="#4A90E2"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasAlarmType, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>

                        <!-- Icono del tipo de alarma (para mensajes con tipoalarma_id) -->
                        <Image Source="{Binding AlarmTypeIconName}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasAlarmType}"/>

                        <!-- Badge con descripción traducida del tipo -->
                        <Frame BackgroundColor="#E3F2FD"
                               CornerRadius="16"
                               Padding="12,6"
                               HasShadow="False"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasAlarmType}">
                            <Label Text="{Binding AlarmTypeDescription}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1565C0"
                                   HorizontalOptions="Center"/>
                        </Frame>
                    </StackLayout>
                </Frame>

                <!-- Asunto -->
                <Frame Style="{StaticResource CardStyle}">
                    <StackLayout Spacing="8">
                        <Label Text="{helpers:TranslateExtension Text='LblAsunto'}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#7F8C8D"/>
                        <Label x:Name="SubjectLabel"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="#2C3E50"
                               Text="{Binding DetalleMensaje.asunto}"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Frame>

                <!-- Información del mensaje -->
                <Frame Style="{StaticResource CardStyle}">
                    <StackLayout Spacing="12">
                        <!-- Fecha -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.Calendar}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="18"
                                   TextColor="#4A90E2"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"/>
                            <Label Grid.Column="1"
                                   x:Name="DateLabel"
                                   FontSize="14"
                                   TextColor="#7F8C8D"
                                   Text="{Binding DetalleMensaje.fecha_mensaje}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                        <!-- Para -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.User}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="18"
                                   TextColor="#27AE60"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"/>
                            <Label Grid.Column="1"
                                   x:Name="ToLabel"
                                   FontSize="14"
                                   TextColor="#7F8C8D"
                                   Text="{Binding ToLabel}"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </Grid>

                        <!-- De -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{x:Static fonts:IconFont.User}"
                                   FontFamily="{StaticResource IcoMoonFamily}"
                                   FontSize="18"
                                   TextColor="#E67E22"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"/>
                            <Label Grid.Column="1"
                                   x:Name="FromLabel"
                                   FontSize="14"
                                   TextColor="#7F8C8D"
                                   Text="{Binding FromLabel}"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Logo del emprendimiento (solo para promociones, si url_logo existe) -->
                <Frame Style="{StaticResource CardStyle}"
                       Padding="12"
                       IsVisible="{Binding HasLogo}">
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="12">
                        <Frame Grid.Column="0"
                               CornerRadius="30"
                               HeightRequest="60"
                               WidthRequest="60"
                               Padding="0"
                               IsClippedToBounds="True"
                               HasShadow="False"
                               BorderColor="#E0E0E0">
                            <Image Source="{Binding DetalleMensaje.url_logo}"
                                   Aspect="AspectFill"
                                   HeightRequest="60"
                                   WidthRequest="60"/>
                        </Frame>
                        <Label Grid.Column="1"
                               Text="{Binding AlarmTypeDescription}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Frame>

                <!-- Foto inline de la alarma (si url_foto existe) -->
                <Frame Style="{StaticResource CardStyle}"
                       Padding="0"
                       IsClippedToBounds="True"
                       IsVisible="{Binding HasPhoto}">
                    <Image Source="{Binding DetalleMensaje.url_foto}"
                           Aspect="AspectFit"
                           MaximumHeightRequest="400"/>
                </Frame>

                <!-- Cuerpo del mensaje -->
                <Frame Style="{StaticResource CardStyle}">
                    <Label x:Name="BodyLabel"
                           FontSize="16"
                           TextColor="#2C3E50"
                           Text="{Binding DetalleMensaje.texto}"
                           LineBreakMode="WordWrap"
                           LineHeight="1.4"/>
                </Frame>

                <!-- Link a alarma (si existe) - con texto dinámico -->
                <Frame Style="{StaticResource CardStyle}"
                       BackgroundColor="#E3F2FD"
                       IsVisible="{Binding DetalleMensaje.alarma_id, Converter={StaticResource NullToBoolConverter}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlarmCommand}"
                                              CommandParameter="{Binding DetalleMensaje.alarma_id}"/>
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{x:Static fonts:IconFont.Bell}"
                               FontFamily="{StaticResource IcoMoonFamily}"
                               FontSize="24"
                               TextColor="#1976D2"
                               VerticalOptions="Center"
                               Margin="0,0,12,0"/>
                        <Label Grid.Column="1"
                               x:Name="LinkLabel"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextDecorations="Underline"
                               TextColor="#1976D2"
                               Text="{Binding ActionButtonText}"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Indicador de carga -->
        <Grid Grid.Row="0"
              BackgroundColor="Black"
              Opacity="0.5"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="#4A90E2"
                               IsRunning="{Binding IsRunning}"/>
        </Grid>

        <!-- Banner publicitario -->
        <Grid BackgroundColor="LightGray" Grid.Row="1" HeightRequest="90">
            <admob:BannerAd AdSize="LargeBanner" />
        </Grid>
    </Grid>
</ContentPage>
