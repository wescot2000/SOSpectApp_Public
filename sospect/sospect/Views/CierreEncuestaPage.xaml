<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:converters="clr-namespace:sospect.Converters;assembly=sospect"
    x:Class="sospect.Views.CierreEncuestaPage"
    Title="{helpers:TranslateExtension Text='LblTituloCierreEncuesta'}"
    BackgroundColor="White">

    <ContentPage.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="SectionLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#333333" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,5" />
        </Style>

        <Style x:Key="ModernEditorStyle" TargetType="Editor">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="PlaceholderColor" Value="#999999" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- ============================================ -->
        <!-- ESTADO 1: No hay solicitud activa - PROPONER -->
        <!-- ============================================ -->
        <ScrollView
            IsVisible="{Binding TieneSolicitudActiva, Converter={StaticResource InverseBooleanConverter}}"
            VerticalScrollBarVisibility="Always"
            HorizontalScrollBarVisibility="Never"
            Padding="20,20,20,10"
            VerticalOptions="FillAndExpand">

            <StackLayout Spacing="15">

                <!-- Titulo -->
                <Label
                    Text="{helpers:TranslateExtension Text='LblTituloProponerCierre'}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    HorizontalTextAlignment="Center"
                    Margin="0,5,0,10" />

                <!-- Descripcion de la propuesta -->
                <StackLayout Spacing="5">
                    <Label
                        Text="{helpers:TranslateExtension Text='LblDescripcionPropuestaCierre'}"
                        Style="{StaticResource SectionLabelStyle}" />

                    <Border
                        StrokeThickness="1"
                        Stroke="#E0E0E0"
                        BackgroundColor="#f8f9fa"
                        Padding="12,10"
                        HeightRequest="120">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Editor
                            Style="{StaticResource ModernEditorStyle}"
                            Placeholder="{helpers:TranslateExtension Text='LblPlaceholderPropuestaCierre'}"
                            Text="{Binding DescripcionPropuesta}"
                            MaxLength="450"
                            AutoSize="TextChanges" />
                    </Border>

                    <!-- Contador de caracteres -->
                    <Label
                        Text="{Binding DescripcionPropuesta.Length, StringFormat='{0}/450'}"
                        FontSize="12"
                        TextColor="#999999"
                        HorizontalTextAlignment="End"
                        Margin="0,-2,5,0" />
                </StackLayout>

                <!-- Seccion de fotos/videos -->
                <StackLayout Spacing="5">
                    <Label
                        Text="{helpers:TranslateExtension Text='LblEvidenciaFotografica'}"
                        Style="{StaticResource SectionLabelStyle}" />

                    <!-- Boton unico de camara (abre popup con 3 opciones) -->
                    <Border
                        StrokeThickness="1"
                        Stroke="#dc3545"
                        BackgroundColor="White"
                        HeightRequest="44"
                        WidthRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCameraButtonTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#x1F4F7;"
                               FontSize="22"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <!-- Vista previa de fotos/videos -->
                    <ScrollView Orientation="Horizontal"
                                HeightRequest="80"
                                Margin="0,5,0,0"
                                IsVisible="{Binding HasMediaFiles}">
                        <CollectionView ItemsSource="{Binding MediaFiles}"
                                        ItemsLayout="HorizontalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Stroke="#E0E0E0"
                                            HeightRequest="70"
                                            WidthRequest="70"
                                            Margin="2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Aspect="AspectFill"/>

                                            <Label Text="&#x25B6;"
                                                   FontSize="24"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsVideo}"/>

                                            <Border BackgroundColor="#80000000"
                                                    HeightRequest="24"
                                                    WidthRequest="24"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveMediaCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="&#x2715;"
                                                       FontSize="14"
                                                       TextColor="White"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>
                </StackLayout>

                <!-- Espaciado para botones fijos -->
                <BoxView HeightRequest="80" Color="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Botones fijos - Estado 1 (Proponer) -->
        <StackLayout
            IsVisible="{Binding TieneSolicitudActiva, Converter={StaticResource InverseBooleanConverter}}"
            BackgroundColor="White"
            Padding="20,10,20,20"
            Spacing="10"
            VerticalOptions="End">

            <BoxView
                HeightRequest="1"
                BackgroundColor="#E0E0E0"
                HorizontalOptions="FillAndExpand" />

            <StackLayout Orientation="Horizontal" Spacing="10">
                <Button
                    Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                    BackgroundColor="#F5F5F5"
                    TextColor="#333333"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="12"
                    BorderColor="#CCCCCC"
                    BorderWidth="1"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding CancelarCommand}" />

                <Button
                    Text="{helpers:TranslateExtension Text='LblBotonProponerCierre'}"
                    BackgroundColor="#dc3545"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="12"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding ProponerCierreCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />
            </StackLayout>
        </StackLayout>

        <!-- ============================================== -->
        <!-- ESTADO 2: Solicitud activa - VOTACION EN CURSO -->
        <!-- ============================================== -->
        <ScrollView
            IsVisible="{Binding TieneSolicitudActiva}"
            VerticalScrollBarVisibility="Always"
            HorizontalScrollBarVisibility="Never"
            Padding="20,20,20,10"
            VerticalOptions="FillAndExpand">

            <StackLayout Spacing="15">

                <!-- Titulo -->
                <Label
                    Text="{helpers:TranslateExtension Text='LblTituloVotacionCierre'}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    HorizontalTextAlignment="Center"
                    Margin="0,5,0,10" />

                <!-- Descripcion de la propuesta -->
                <Border
                    StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="#f8f9fa"
                    Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="8">
                        <Label
                            Text="{helpers:TranslateExtension Text='LblDescripcionPropuesta'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#555555" />
                        <Label
                            Text="{Binding SolicitudActiva.descripcion}"
                            FontSize="15"
                            TextColor="#333333"
                            LineBreakMode="WordWrap" />
                    </StackLayout>
                </Border>

                <!-- R6: Fotos de la propuesta (visible cuando la API retorne fotos_json) -->
                <ScrollView
                    Orientation="Horizontal"
                    HeightRequest="90"
                    IsVisible="{Binding HasFotos}">
                    <CollectionView
                        ItemsSource="{Binding SolicitudActiva.Fotos}"
                        ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeThickness="1"
                                    Stroke="#E0E0E0"
                                    HeightRequest="80"
                                    WidthRequest="80"
                                    Margin="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ThumbnailUrlOrOriginal}"
                                               Aspect="AspectFill"/>
                                        <Label
                                            Text="&#x25B6;"
                                            FontSize="28"
                                            TextColor="White"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding EsVideo}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                <!-- R5: Aviso de resultados ocultos (mientras el usuario no ha votado) -->
                <Border
                    IsVisible="{Binding PuedeVotar}"
                    StrokeThickness="0"
                    BackgroundColor="#e3f2fd"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label
                        Text="{helpers:TranslateExtension Text='LblResultadosOcultos'}"
                        FontSize="13"
                        TextColor="#0d47a1"
                        HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Conteo de votos (R5: solo visible después de votar) -->
                <Border
                    IsVisible="{Binding SolicitudActiva.ya_voto_usuario}"
                    StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="White"
                    Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="10">
                        <Label
                            Text="{helpers:TranslateExtension Text='LblResultadosVotacion'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#555555"
                            HorizontalTextAlignment="Center" />

                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="30">
                            <!-- Votos a favor -->
                            <StackLayout HorizontalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding SolicitudActiva.votos_si}"
                                    FontSize="28"
                                    FontAttributes="Bold"
                                    TextColor="#28a745"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="{helpers:TranslateExtension Text='LblVotosAFavor'}"
                                    FontSize="12"
                                    TextColor="#666666"
                                    HorizontalTextAlignment="Center" />
                            </StackLayout>

                            <!-- Separador -->
                            <BoxView
                                WidthRequest="1"
                                BackgroundColor="#E0E0E0"
                                VerticalOptions="FillAndExpand" />

                            <!-- Votos en contra -->
                            <StackLayout HorizontalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding SolicitudActiva.votos_no}"
                                    FontSize="28"
                                    FontAttributes="Bold"
                                    TextColor="#dc3545"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="{helpers:TranslateExtension Text='LblVotosEnContra'}"
                                    FontSize="12"
                                    TextColor="#666666"
                                    HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Tiempo restante -->
                <Border
                    StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="#fff3cd"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8">
                        <Label
                            Text="{helpers:TranslateExtension Text='LblTiempoRestanteVotacion'}"
                            FontSize="14"
                            TextColor="#856404"
                            VerticalTextAlignment="Center" />
                        <Label
                            Text="{Binding TiempoRestante}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#856404"
                            VerticalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <!-- Estado del voto del usuario -->
                <Border
                    IsVisible="{Binding SolicitudActiva.ya_voto_usuario}"
                    StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="#d4edda"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label
                        Text="{Binding TextoVotoUsuario}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#155724"
                        HorizontalTextAlignment="Center" />
                </Border>

                <!-- R2: Banner para el proponente (no puede votar) -->
                <Border
                    IsVisible="{Binding EsProponenteCierre}"
                    StrokeThickness="0"
                    BackgroundColor="#fff3cd"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label
                        Text="{helpers:TranslateExtension Text='MsgEresProponenteCierre'}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#856404"
                        HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Botones de votacion (solo si no ha votado Y no es proponente) -->
                <StackLayout
                    IsVisible="{Binding PuedeVotar}"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,10,0,0">

                    <Button
                        Text="{helpers:TranslateExtension Text='LblVotarAFavor'}"
                        BackgroundColor="#28a745"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="12"
                        HorizontalOptions="FillAndExpand"
                        Command="{Binding VotarAFavorCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />

                    <Button
                        Text="{helpers:TranslateExtension Text='LblVotarEnContra'}"
                        BackgroundColor="#dc3545"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="12"
                        HorizontalOptions="FillAndExpand"
                        Command="{Binding VotarEnContraCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />
                </StackLayout>

                <!-- Espaciado para boton fijo -->
                <BoxView HeightRequest="80" Color="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Boton fijo - Estado 2 (Volver) -->
        <StackLayout
            IsVisible="{Binding TieneSolicitudActiva}"
            BackgroundColor="White"
            Padding="20,10,20,20"
            Spacing="10"
            VerticalOptions="End">

            <BoxView
                HeightRequest="1"
                BackgroundColor="#E0E0E0"
                HorizontalOptions="FillAndExpand" />

            <!-- R7: Ver historial de alarma (solo lectura) -->
            <Button
                Text="{helpers:TranslateExtension Text='LblVerHistorialAlarma'}"
                BackgroundColor="#6c757d"
                TextColor="White"
                FontSize="14"
                HeightRequest="50"
                CornerRadius="12"
                HorizontalOptions="FillAndExpand"
                Command="{Binding VerHistorialCommand}" />

            <Button
                Text="{helpers:TranslateExtension Text='LabelCancelar'}"
                BackgroundColor="#F5F5F5"
                TextColor="#333333"
                FontSize="14"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="12"
                BorderColor="#CCCCCC"
                BorderWidth="1"
                HorizontalOptions="FillAndExpand"
                Command="{Binding CancelarCommand}" />
        </StackLayout>

        <!-- Loading overlay -->
        <Grid
            IsVisible="{Binding IsRunning}"
            BackgroundColor="#80000000"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand">
            <Border
                BackgroundColor="White"
                Padding="30"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <StackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator
                        IsRunning="True"
                        Color="#dc3545"
                        WidthRequest="40"
                        HeightRequest="40" />
                    <Label
                        Text="{helpers:TranslateExtension Text='LblProcesando'}"
                        FontSize="14"
                        TextColor="#333333"
                        HorizontalTextAlignment="Center" />
                </StackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
