<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fonts="clr-namespace:sospect.Resources.Fonts;assembly=sospect"
    xmlns:helpers="clr-namespace:sospect.Helpers"
    xmlns:local="clr-namespace:sospect.TemplateSelectors"
    xmlns:converters="clr-namespace:sospect.Converters"
    Title="SOSpect"
    BackgroundColor="White"
    x:Class="sospect.Views.VerHistorialAlarmaPage">

    <ContentPage.Resources>
        <converters:BooleanNegatorConverter x:Key="BooleanNegatorConverter" />

        <!-- Template propio — solo lectura, sin botones de calificación, con fotos -->
        <DataTemplate x:Key="HistorialPropioTemplate">
            <ViewCell>
                <Grid Padding="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Text="{helpers:TranslateExtension Text='Tu'}"
                           Grid.Column="0"
                           VerticalTextAlignment="Center"
                           TextColor="Blue"
                           FontSize="14"
                           Margin="0,0,8,0"
                           IsVisible="{Binding PropietarioDescripcion}"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#007AFF"
                            StrokeThickness="0"
                            Margin="60,5,10,5"
                            HorizontalOptions="End"
                            Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Contenido del mensaje -->
                            <StackLayout Grid.Row="0" Spacing="6">

                                <Label Text="{Binding TextoFlagRedConfianza}"
                                       TextColor="LightGreen"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding FlagRedConfianza}"/>

                                <StackLayout IsVisible="{Binding Descripcionalarma, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionAlarma'}"
                                           FontAttributes="Bold" TextColor="White" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionalarma}"
                                           TextColor="White" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionsospechoso, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionSospechoso'}"
                                           FontAttributes="Bold" TextColor="White" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionsospechoso}"
                                           TextColor="White" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionvehiculo, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionVehiculo'}"
                                           FontAttributes="Bold" TextColor="White" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionvehiculo}"
                                           TextColor="White" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionarmas, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionArma'}"
                                           FontAttributes="Bold" TextColor="White" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionarmas}"
                                           TextColor="White" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <!-- Miniaturas de fotos — igual que DetalleDescripcionAlarmaPage -->
                                <CollectionView ItemsSource="{Binding Fotos}"
                                                IsVisible="{Binding TieneFotos}"
                                                HeightRequest="88"
                                                Margin="0,6,0,0">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="1"
                                                    Stroke="WhiteSmoke"
                                                    StrokeShape="RoundRectangle 6"
                                                    HeightRequest="80"
                                                    WidthRequest="80">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.VerFotoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrlOrOriginal}"
                                                           Aspect="AspectFill"
                                                           HeightRequest="80"
                                                           WidthRequest="80"/>
                                                    <!-- Icono de play para videos -->
                                                    <Label Text="▶"
                                                           FontSize="32"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding EsVideo}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </StackLayout>

                            <!-- Fecha y hora del mensaje -->
                            <Label Grid.Row="1"
                                   Text="{Binding FechadescripcionLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="11" TextColor="WhiteSmoke"
                                   HorizontalOptions="End"
                                   HorizontalTextAlignment="End"
                                   Margin="0,4,0,0"
                                   Opacity="0.8"/>
                        </Grid>
                    </Border>
                </Grid>
            </ViewCell>
        </DataTemplate>

        <!-- Template ajeno — solo lectura, sin botones de calificación, con fotos -->
        <DataTemplate x:Key="HistorialAjenoTemplate">
            <ViewCell>
                <Grid Padding="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BackgroundColor="#E5E5EA"
                            StrokeThickness="0"
                            Margin="10,5,60,5"
                            HorizontalOptions="Start"
                            Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Contenido del mensaje -->
                            <StackLayout Grid.Row="0" Spacing="6">

                                <Label Text="{Binding TextoFlagRedConfianza}"
                                       TextColor="Green"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding FlagRedConfianza}"/>

                                <StackLayout IsVisible="{Binding Descripcionalarma, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionAlarma'}"
                                           FontAttributes="Bold" TextColor="Black" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionalarma}"
                                           TextColor="Black" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionsospechoso, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionSospechoso'}"
                                           FontAttributes="Bold" TextColor="Black" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionsospechoso}"
                                           TextColor="Black" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionvehiculo, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionVehiculo'}"
                                           FontAttributes="Bold" TextColor="Black" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionvehiculo}"
                                           TextColor="Black" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <StackLayout IsVisible="{Binding Descripcionarmas, Converter={StaticResource StringNullOrEmptyToBoolConverter}}">
                                    <Label Text="{helpers:TranslateExtension Text='DescripcionArma'}"
                                           FontAttributes="Bold" TextColor="Black" FontSize="13" Margin="0,0,0,2"/>
                                    <Label Text="{Binding Descripcionarmas}"
                                           TextColor="Black" FontSize="14" LineBreakMode="WordWrap"/>
                                </StackLayout>

                                <!-- Miniaturas de fotos — igual que DetalleDescripcionAlarmaPage -->
                                <CollectionView ItemsSource="{Binding Fotos}"
                                                IsVisible="{Binding TieneFotos}"
                                                HeightRequest="88"
                                                Margin="0,6,0,0">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="1"
                                                    Stroke="Gray"
                                                    StrokeShape="RoundRectangle 6"
                                                    HeightRequest="80"
                                                    WidthRequest="80">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.VerFotoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrlOrOriginal}"
                                                           Aspect="AspectFill"
                                                           HeightRequest="80"
                                                           WidthRequest="80"/>
                                                    <!-- Icono de play para videos -->
                                                    <Label Text="▶"
                                                           FontSize="32"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding EsVideo}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </StackLayout>

                            <!-- Fecha y hora del mensaje -->
                            <Label Grid.Row="1"
                                   Text="{Binding FechadescripcionLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="11" TextColor="Gray"
                                   HorizontalOptions="End"
                                   HorizontalTextAlignment="End"
                                   Margin="0,4,0,0"
                                   Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <Label Grid.Column="1"
                           TextColor="Gray" FontSize="12"
                           Text="{helpers:TranslateExtension Text='Anonimo'}"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Start"
                           Margin="6,0,0,0"
                           IsVisible="{Binding Descripcionalarma, Converter={StaticResource StringNullOrEmptyToBoolConverter}}"/>
                </Grid>
            </ViewCell>
        </DataTemplate>

        <local:DescripcionAlarmaTemplateSelector x:Key="HistorialTemplateSelector"
            PropioTemplate="{StaticResource HistorialPropioTemplate}"
            AjenoTemplate="{StaticResource HistorialAjenoTemplate}"/>

    </ContentPage.Resources>

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner: alarma en proceso de votación de cierre -->
        <Border Grid.Row="0"
                BackgroundColor="#FFF3CD"
                StrokeThickness="0"
                Padding="12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Label Text="{helpers:TranslateExtension Text='LblAlarmaEnVotacionCierre'}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#856404"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- Lista de descripciones -->
        <Grid Grid.Row="1">

            <Label Text="{helpers:TranslateExtension Text='LblNoHayRegistrosAqui'}"
                   TextColor="Gray"
                   FontSize="15"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding EmptyState}"/>

            <ListView x:Name="HistorialListView"
                      BackgroundColor="White"
                      SelectionMode="None"
                      SeparatorVisibility="None"
                      ItemsSource="{Binding ListadoDescripcionesAlarmas}"
                      HasUnevenRows="True"
                      VerticalOptions="FillAndExpand"
                      ItemTemplate="{StaticResource HistorialTemplateSelector}"/>
        </Grid>

        <!-- Botones de solo lectura -->
        <StackLayout Grid.Row="2"
                     Orientation="Horizontal"
                     Spacing="8"
                     Padding="10,10,10,20">

            <Button Text="{helpers:TranslateExtension Text='LblVerEnMapa'}"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="13"
                    CornerRadius="8"
                    HeightRequest="48"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding VerAlarmaEnMapaCommand}"
                    CommandParameter="{Binding AlarmaSeleccionada}"/>

            <Button Text="{helpers:TranslateExtension Text='LblVerAutoridadesResponsables'}"
                    BackgroundColor="#1A6FB4"
                    TextColor="White"
                    FontSize="13"
                    CornerRadius="8"
                    HeightRequest="48"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding AlarmaSeleccionada.MostrarAutoridadesResponsables}"
                    Command="{Binding VerAutoridadesResponsablesCommand}"
                    CommandParameter="{Binding AlarmaSeleccionada}"/>
        </StackLayout>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsRunning}">
            <ActivityIndicator VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="DarkBlue"
                               IsRunning="{Binding IsRunning}"/>
        </Grid>

    </Grid>

</ContentPage>
