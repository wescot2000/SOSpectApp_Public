 <Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>sospect</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>SOSpect</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.wescotcorp.sospect</ApplicationId>

		<!-- Versions -->
    <ApplicationDisplayVersion>2.1.79</ApplicationDisplayVersion>
    <ApplicationVersion>79</ApplicationVersion>
    <PackageVersion>2.1.79</PackageVersion>

    <AndroidVersionCode>79</AndroidVersionCode>
    <AndroidVersionName>2.1.79</AndroidVersionName>
    
    <!-- Firma Android: se aplica a Debug y Release.
         Mientras la app está en fase de arranque (un solo desarrollador) se usa el mismo keystore
         de producción en todas las configuraciones — mismo SHA-1 registrado en Firebase/Google.
         Las variables se inyectan por máquina (Directory.Build.props local, no versionado) o por CI/CD. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(AndroidSigningKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(AndroidSigningStorePass)</AndroidSigningStorePass>

	<AndroidMinSdkVersion>23</AndroidMinSdkVersion>
	<AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
	<AndroidCompileSdkVersion>35</AndroidCompileSdkVersion>

    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <AndroidDexTool>d8</AndroidDexTool>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    <MauiGenerateSplashScreen>false</MauiGenerateSplashScreen>
	</PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <CreateBindingResourcePackage>false</CreateBindingResourcePackage>
    <EnableDefaultCodesignEntitlements>false</EnableDefaultCodesignEntitlements>
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Usar LaunchScreen.storyboard nativo para splash a pantalla completa -->
    <MauiGenerateSplashScreen>false</MauiGenerateSplashScreen>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\LaunchScreen.storyboard" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <!-- NUCLEAR: Desactivar ABSOLUTAMENTE TODO -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidLinkSkip>true</AndroidLinkSkip>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>none</TrimMode>
    <EnableLLVM>false</EnableLLVM>

    <!-- Desactivar AOT -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AotAssemblies>false</AotAssemblies>

    <!-- Bundle -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>

    <!-- Debugging -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Desactivar Proguard temporalmente -->
    <AndroidEnableProguard>false</AndroidEnableProguard>

    <!-- Evitar optimizaciones -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidStripILAfterAOT>false</AndroidStripILAfterAOT>

    <!-- CRITICO: Preservar reflection -->
    <MtouchLink>None</MtouchLink>
    <AndroidSkipBindingConflictChecks>true</AndroidSkipBindingConflictChecks>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiGenerateSplashScreen>false</MauiGenerateSplashScreen>
    <!-- Configurar splash screen nativo para Android 12+ -->
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
  </PropertyGroup>

		<ItemGroup>
			<!-- App Icon -->
      <MauiIcon Include="Resources\AppIcon\icon.png" Color="#000000" BaseSize="192,192" />
      
      <!-- SPLASH para iOS: se usa LaunchScreen.storyboard nativo (ver Platforms/iOS/LaunchScreen.storyboard).
           La imagen se sirve desde Platforms/iOS/Assets.xcassets/splash_sospect.imageset/
           NO usar MauiSplashScreen para iOS porque genera un segundo storyboard pequeño en paralelo. -->

      <!-- Images -->
			<MauiImage Include="Resources\Images\*" />
			<!-- Custom Fonts -->
      <MauiFont Include="Resources\Fonts\icomoon.ttf" />
      <MauiFont Include="Resources\Fonts\OpenSans-Regular.ttf" />
      <MauiFont Include="Resources\Fonts\OpenSans-Semibold.ttf" />
			<!-- Raw Assets -->
			<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		</ItemGroup>

