  <!-- Limpiar atributos extendidos antes de codesign (iOS - solo macOS) -->
  <Target Name="_CleanExtendedAttributesBeforeCodesign"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND $([MSBuild]::IsOSPlatform('OSX'))"
          BeforeTargets="_CodesignAppBundle">
    <Message Text="&gt;&gt;&gt; Cleaning xattrs from $(AppBundleDir)" Importance="high" />
    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;" />
  </Target>

  <!-- Plugin.AdMob: enlazar bibliotecas Swift del Google Mobile Ads SDK para iOS -->
  <Target Name="LinkSwiftLibraries" Condition="'$(TargetFramework)' == 'net10.0-ios' AND $([MSBuild]::IsOSPlatform('OSX'))" AfterTargets="_SayHello">
    <PropertyGroup>
      <_SwiftLibPath>$(HOME)/Library/Developer/Xcode/DerivedData</_SwiftLibPath>
    </PropertyGroup>
    <ItemGroup>
      <_SwiftLibSearchPath Include="/usr/lib/swift" />
    </ItemGroup>
  </Target>

