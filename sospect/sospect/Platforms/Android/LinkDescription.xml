    <type fullname="CommunityToolkit.Maui.Core.CameraManager" preserve="all">
      <method signature="*" preserve="all" />
      <field signature="*" preserve="all" />
    </type>
    <type fullname="CommunityToolkit.Maui.Core.CameraManager+ImageCallBack" preserve="all">
      <method signature="*" preserve="all" />
      <field signature="*" preserve="all" />
    </type>
  </assembly>

  <assembly fullname="CommunityToolkit.Maui.Camera">
    <type fullname="*" preserve="all" />
  </assembly>
