<?xml version="1.0" encoding="UTF-8" ?>
<linker>
  <!-- Preservar COMPLETAMENTE Microsoft.Maui.Controls -->
  <assembly fullname="Microsoft.Maui.Controls">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar COMPLETAMENTE Microsoft.Maui -->
  <assembly fullname="Microsoft.Maui">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar Microsoft.Maui.Graphics -->
  <assembly fullname="Microsoft.Maui.Graphics">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar Microsoft.Maui.Essentials -->
  <assembly fullname="Microsoft.Maui.Essentials">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar tu aplicación -->
  <assembly fullname="sospect">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar System.Drawing -->
  <assembly fullname="System.Drawing.Primitives">
    <type fullname="*" preserve="all" />
  </assembly>

  <!-- Preservar tipos específicos problemáticos -->
  <assembly fullname="Microsoft.Maui.Controls">
    <type fullname="Microsoft.Maui.Controls.VisualElement" preserve="all">
