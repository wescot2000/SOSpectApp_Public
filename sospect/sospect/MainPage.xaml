<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sospect.MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <OnPlatform x:Key="FontAwesomeFamily" x:TypeArguments="x:String">
                <On Platform="iOS" Value="Font Awesome 6 Free-Regular-400"/>
                <On Platform="Android" Value="Font Awesome 6 Free-Regular-400.otf#Font Awesome 6 Free-Regular-400"/>
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <!-- Página vacía - la navegación se maneja en App.xaml.cs -->
    </StackLayout>

</ContentPage>